??_C@_0BMI@BBGHGPEO@?$CDinclude?5?$DM?4?4?1?4?4?1lib?1constBuf?4sh@ DB '#'
	DB	'include <../../lib/constBuf.shader>', 0aH, '#include <../../l'
	DB	'ib/io.shader>', 0aH, '#include <../../lib/constants.shader>', 0aH
	DB	0aH, '//[', 0aH, 'cbuffer params : register(b0)', 0aH, '{', 0aH
	DB	'    float4 position [4000];', 0aH, '}', 0aH, '//]', 0aH, 0aH, 0aH
	DB	'VS_OUTPUT_POS_UV VS(uint vID : SV_VertexID)', 0aH, '{', 0aH, ' '
	DB	'   VS_OUTPUT_POS_UV output = (VS_OUTPUT_POS_UV) 0;', 0aH, '  '
