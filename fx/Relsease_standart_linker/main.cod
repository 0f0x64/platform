	DB	'pos,float a)', 0aH, '{', 0aH, '    float3x3 m =', 0aH, '    {'
	DB	0aH, '        1, 0,       0,', 0aH, '        0, cos(a), -sin(a'
	DB	'),', 0aH, '        0, sin(a), cos(a)', 0aH, '    };', 0aH, ' '
	DB	'   pos = mul(pos, m);', 0aH, '    return pos;', 0aH, '}', 0aH
	DB	0aH, 'float3 rotY(float3 pos, float a)', 0aH, '{', 0aH, '    f'
	DB	'loat3x3 m =', 0aH, '    {', 0aH, '        cos(a), 0, sin(a),', 0aH
	DB	'        0, 1, 0,', 0aH, '        -sin(a), 0, cos(a)', 0aH, ' '
	DB	'   };', 0aH, '    pos = mul(pos, m);', 0aH, '    return pos;', 0aH
	DB	'}', 0aH, 0aH, 'float3 rotZ(float3 pos, float a)', 0aH, '{', 0aH
