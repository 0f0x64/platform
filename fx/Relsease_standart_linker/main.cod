	DB	',0);', 0aH, '    pos=ofs3+rotY(pos-ofs3,pow(grid.y,4)*(pos.x*'
	DB	'2+2));', 0aH, '    ', 0aH, '    pos.x/=2;', 0aH, '    pos=rot'
	DB	'Y(pos,sin(grid.y*12));', 0aH, 0aH, '    float3 ofs = float3(', 0aH
	DB	'        hash(iid*2),', 0aH, '        hash(iid*3),', 0aH, '   '
	DB	'     hash(iid*4)', 0aH, '    );', 0aH, '    ofs-=.5;', 0aH, ' '
	DB	'   ofs*=(1-pow(grid.y,2.07-power))/16.;', 0aH, 0aH, '    pos+'
	DB	'=ofs;', 0aH, 0aH, '    pos=rotZ(pos,pos.x*PI*.4);', 0aH, '   '
	DB	' float c=3;', 0aH, '    pos=rotY(pos,(iid%c)*PI/c);', 0aH, ' '
	DB	'   pos.y-=pow(length(pos.xz),1.7)*1.4;', 0aH, '    ', 0aH, ' '
	DB	'   float3 ofs2 = float3(', 0aH, '        hash(iid*2),', 0aH, ' '
	DB	'       hash(iid*3)-.2,', 0aH, '        hash(iid*4)', 0aH, '  '
	DB	'  );', 0aH, '    ofs2-=.5;', 0aH, '    ofs2=normalize(ofs2);', 0aH
	DB	'    ofs2.y-=.4;', 0aH, '    ofs2.y*=2;', 0aH, 0aH, '    pos.y'
	DB	'/=1.5;', 0aH, '    pos+=noise3(pos*253*grid.y+222)*pow(grid.y'
	DB	',2)/5;', 0aH, '    pos.y-=.25;', 0aH, '    float c2=1+saturat'
	DB	'e(-pos.y-.1)*22;', 0aH, '    ', 0aH, '    pos.y-=saturate(-po'
	DB	's.y-.1)*noise(pos*2+atan2(pos.x,pos.z)*3);', 0aH, '    pos.xz'
	DB	'*=c2;', 0aH, 0aH, '    pos.y-=.05;', 0aH, '    return pos*18;'
	DB	0aH, '}', 0aH, 0aH, 0aH, 0aH, 'pos_color CalcParticles(uint qi'
	DB	'd,uint iid,float4 grid)', 0aH, '{', 0aH, '     qid *= skipper'
	DB	';', 0aH, '     float t=time.x*.004;', 0aH, '     uint inStars'
	DB	' = 21232;', 0aH, '     if (mode==1||iid%inStars==0)', 0aH, ' '
	DB	'    {', 0aH, '        t=0;', 0aH, '     }', 0aH, 0aH, '    //'
	DB	'pillars instances', 0aH, 0aH, 0aH, '    //calc', 0aH, '    fl'
	DB	'oat3 pos = pillar(qid,iid,grid.xy,0,t,0);', 0aH, '    pos=rot'
	DB	'Z(pos,pos.y*length(pos)*sin(time.x/50)/280);', 0aH, 0aH, '   '
	DB	' float3 pos2=pos;', 0aH, '    ', 0aH, '    //scatter', 0aH, ' '
	DB	'   ', 0aH, '    //color', 0aH, '    pos_color p;', 0aH, '    '
	DB	'float4 prgba = float4(noise3_u(pos2/.4/2)*float3(3.4,3.5,1.),'
	DB	'1)/74.+float4(0,.015,0,0);', 0aH, '    float4 prgba2 = float4'
	DB	'(noise3_u(pos2/.4/2)*float3(1.4,.5,0.),1)/4.+.0015;    ', 0aH
	DB	'    p.color = lerp(prgba,prgba2,saturate(.1-pos.y/13));', 0aH
	DB	0aH, 0aH, '    if (mode==1)', 0aH, '    {', 0aH, '        p.po'
	DB	's=transform(pos,grid.zw,22);', 0aH, '        p.color*=pow(pos'
	DB	'.y+2,2)/20;', 0aH, '        p.sz=172;', 0aH, '    }', 0aH, ' '
	DB	'   else', 0aH, '    {', 0aH, '        p.pos = transform_unisi'
	DB	'ze(pos,grid.zw,1.5);', 0aH, '         p.sz=1;', 0aH, 0aH, '  '
	DB	'       if (iid%inStars==0)', 0aH, '         {', 0aH, '       '
	DB	'       p.pos = transform_unisize(pos,grid.zw,51.5);', 0aH, ' '
	DB	'              p.sz=2;', 0aH, '               p.color=float4(0'
	DB	',1,1,0)/3;', 0aH, '         }', 0aH, 0aH, '    }', 0aH, ' ', 0aH
	DB	'   ', 0aH, '    //density compensation', 0aH, '    //p.color/'
	DB	'=min(pow(p.pos.w,1.1)*.21+.5,11);', 0aH, '    return p;', 0aH
	DB	'}', 0aH, 0aH, '#include <../lib/particleVS_main2.shader>', 0aH
	DB	00H						; `string'
