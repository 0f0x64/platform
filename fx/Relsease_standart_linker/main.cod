	DB	'}', 0aH, 0aH, 'float quantize2(float x, float q)', 0aH, '{', 0aH
	DB	'    return floor(x*q)/q;', 0aH, '}', 0aH, 0aH, 'float3 torus('
	DB	'float u, float v, float R, float r) {', 0aH, '    float TWO_P'
	DB	'I = 6.283185307;', 0aH, '    float theta = u * TWO_PI/3; // A'
	DB	'ngle around the major ring', 0aH, '    float phi = v * TWO_PI'
