	DB	' gX;', 0aH, '    int gY;', 0aH, '    int mode;', 0aH, '    in'
	DB	't skipper;', 0aH, '    float4 base_color;', 0aH, '}', 0aH, 0aH
	DB	'float toRad(float a)', 0aH, '{', 0aH, '    return a*PI/180.;', 0aH
	DB	'}', 0aH, 0aH, 'float3 pillar(uint qid,uint iid,float2 grid,fl'
	DB	'oat a, float t, float h)', 0aH, '{', 0aH, '    float3 pos = f'
	DB	'loat3(hash(iid/200.),hash(iid/140.),hash(iid/120.))-.5;', 0aH
	DB	'    float3 pos3=pos;', 0aH, '    pos=normalize(pos)*2;', 0aH, 0aH
	DB	'    uint inStars = 10000;', 0aH, '    float t2= (iid%inStars='
	DB	'=0||mode!=0) ? 0: time.x;', 0aH, 0aH, '    //pos+=pos*noise3('
	DB	'pos*3);', 0aH, 0aH, '    pos*=4;', 0aH, '    ', 0aH, '    a=h'
	DB	'ash(iid/1000.);', 0aH, '    pos=rot3(pos,pos/3);', 0aH, 0aH, ' '
	DB	'   pos+= noise3(pos*2+t2/42)*.8;', 0aH, '    //pos = rot3(pos'
