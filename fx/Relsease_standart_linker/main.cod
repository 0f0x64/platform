??_C@_0IKM@BNPPNKMI@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#inc'
	DB	'lude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sha'
	DB	'der>', 0aH, '#include <../lib/constants.shader>', 0aH, '#incl'
	DB	'ude <../lib/utils.shader>', 0aH, 0aH, 'cbuffer params : regis'
	DB	'ter(b0)', 0aH, '{', 0aH, '    float4x4 model;', 0aH, '    int'
	DB	' gX;', 0aH, '    int gY;', 0aH, '    int mode;', 0aH, '    in'
	DB	't skipper;', 0aH, '    float4 base_color;', 0aH, ' ', 0aH, '}'
	DB	0aH, 0aH, 'float3 pillar(float2 grid,float a, float t, float h'
	DB	')', 0aH, '{', 0aH, '    float3 pos = shp(grid.xy);', 0aH, '  '
	DB	'  //heigth', 0aH, '    pos.y*=.8+h;', 0aH, '    pos.y+=h;', 0aH
	DB	0aH, '    pos*=1+noise3(pos*111.6+1111/(a+1))*1.6;', 0aH, '   '
	DB	' pos.y*=1.8;', 0aH, '    pos*=1+noise3(pos*1.6+1111/(a+1)+t);'
	DB	0aH, '    pos = rot3(pos,2.2/(pow(pos,14)+1));', 0aH, '    pos'
	DB	'.y*=1.5;', 0aH, '    pos*=1+noise3(pos+1111/(a+1)+t);', 0aH, ' '
	DB	'   pos*=1+noise3(pos*3.5)/3;', 0aH, '    pos*=2;', 0aH, '    '
	DB	'return pos;', 0aH, '}', 0aH, 0aH, 'pos_color CalcParticles(ui'
	DB	'nt qid,float4 grid)', 0aH, '{', 0aH, '    uint stars= qid%340'
	DB	';', 0aH, '    uint cn=7;', 0aH, '    float a= (qid%cn);', 0aH
	DB	'    a=a*PI/180.;', 0aH, '    a*=360./cn;', 0aH, '    float t='
	DB	'time.x*.1;', 0aH, '    float3 pos = pillar(grid.xy,0,t*.005,.'
	DB	'5)/5;', 0aH, '    float3 pos2=pos;', 0aH, 0aH, '        pos.y'
	DB	'*=0;', 0aH, '        pos.xz*=9;', 0aH, '        pos.x*=.6;', 0aH
	DB	'        pos=rotY(pos,length(pos)*.3+a-time.x*.005);', 0aH, ' '
	DB	'       pos.y+=length(pos)/7;', 0aH, '        pos.y-=4.5;', 0aH
	DB	'        ', 0aH, 0aH, '        pos+=noise3(qid*float3(1,2,3)*1'
	DB	'1.1)*2;', 0aH, 0aH, '        pos_color p;', 0aH, '        p.c'
	DB	'olor = float4(1,2,3,1)/120.+.0015;', 0aH, 0aH, '        if (s'
	DB	'tars==0)', 0aH, '        {', 0aH, '            p.pos = transf'
	DB	'orm_unisize(pos,grid.zw,1.);', 0aH, '            p.sz=1;', 0aH
	DB	'        }', 0aH, '        else', 0aH, '        {', 0aH, '    '
	DB	'        if (mode==0)', 0aH, '            {', 0aH, '          '
	DB	'  float sz=28;', 0aH, '      ', 0aH, '            p.pos = tra'
	DB	'nsform_unisize(pos,grid.zw,sz);', 0aH, '            p.sz=2;', 0aH
	DB	'            } ', 0aH, '            else', 0aH, '            {'
	DB	0aH, '                float sz=4;', 0aH, '                p.po'
	DB	's = transform(pos,grid.zw,sz);', 0aH, '                p.sz=2'
	DB	';', 0aH, '            }', 0aH, '        }', 0aH, 0aH, '      '
	DB	'  p.color = float4(noise3_u(a*base_color.rgb+77+sin(pos2*11.4'
	DB	')),1)/50.+.00015;', 0aH, '        if (mode!=0&&stars!=0)', 0aH
	DB	'        {', 0aH, '           // p.color.rgb*=noise(1*rotY(pos'
	DB	',length(pos)-time.x*.005))*3.2+.012;', 0aH, 0aH, '        }', 0aH
	DB	'        p.color*=base_color/2;', 0aH, '        ', 0aH, '     '
	DB	'   if (stars==0&&mode==0)', 0aH, '        {', 0aH, '         '
	DB	'   p.color*=540;', 0aH, '            p.sz=1;', 0aH, '        '
	DB	'}', 0aH, 0aH, '        if (stars!=0&&mode==1) p.color*=2.5;', 0aH
	DB	'        if (stars!=0&&mode==0) p.color*=1.5;', 0aH, ' ', 0aH, 0aH
	DB	'    //density compensation', 0aH, '  //  p.color/=min(pow(p.p'
	DB	'os.w,1.1)*.1+1.5,5);', 0aH, '    ', 0aH, '    return p;', 0aH
	DB	'} ', 0aH, 0aH, '#include <../lib/particleVS_main.shader>', 0aH
	DB	00H						; `string'
CONST	ENDS
;	COMDAT ??_C@_0IMG@GKIECDGH@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
