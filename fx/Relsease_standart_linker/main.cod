	DB	'(2000. * 1000.);', 0aH, '    //g_1+=noise3(iid/(2000. * 1000.'
	DB	')*22);', 0aH, '    //g=lerp(g,g_1,iid/(2000. * 1000.));', 0aH
	DB	'    ', 0aH, 0aH, '   // g.y+=noise(time.x/50)*12;', 0aH, '   '
	DB	'// g+=hash33(g+hash(iid))*.15;', 0aH, '    float margin = iid'
	DB	'%2>(noise(g+time.x/10+222)*3+1);', 0aH, '    margin/=4;', 0aH
	DB	'   // g.xyz+=margin*noise3(iid/292100.+g/3)*12*(py);', 0aH, ' '
	DB	'  // g.xyz+=margin*noise3(g/3)*2;', 0aH, '   // g.y+=margin*p'
	DB	'ow(frac(iid/292100.+time.x/20),1)*7;', 0aH, 0aH, '   /* float'
	DB	'3 nn=g/4;', 0aH, '    for (int i = 0; i < 8; i++) {', 0aH, ' '
	DB	'       p_prev = nn;', 0aH, '        float3 next = noise3(nn*8'
	DB	'+22+a/b+(time.x/32)*0);', 0aH, '        ', 0aH, '        nn -'
	DB	'=next/(i+1)*(1-form);', 0aH, '        //nn=rot3(nn,nn*3*(1-fo'
	DB	'rm));', 0aH, '        nn=lerp(nn,rot3(nn,nn*1),(1-form));', 0aH
	DB	'        nn+=(rot3(nn-nn/2,nn*.1)+nn/2)/51*form;', 0aH, '     '
	DB	'   nn += next/(i+1)*form;', 0aH, 0aH, 0aH, '    }*/', 0aH, 0aH
	DB	'    //g=lerp(g,nn*33,sm2(sm2(tm)) );', 0aH, '    //g*=8;', 0aH
	DB	'    float3 g2=normalize(hash3(iid))*84*hash(iid)+noise3(g/2)*'
	DB	'25;', 0aH, 0aH, '    p=lerp(g2,p,saturate(length(p)/112));', 0aH
	DB	'    float girl = saturate(pow(length(p)/28,.75)-1.9);', 0aH, ' '
	DB	'   p=lerp(g2,p,saturate(pow(length(p)/18,.75)-2));', 0aH, '  '
	DB	'  p=lerp(g,p,saturate(pow(length(p)/13,.75)-2));', 0aH, 0aH, ' '
	DB	'   //p=g;', 0aH, '    //p=lerp(p,g*8,1-form);', 0aH, '    ', 0aH
	DB	'    //g*=8;', 0aH, '    ', 0aH, 0aH, '    float3 nebulaColor '
	DB	'= lerp(_ColorCold.rgb, _ColorHot.rgb, pow(heat, 3.0));', 0aH, ' '
	DB	'   p1.color = float4(nebulaColor, 1);', 0aH, 0aH, '    p1.col'
	DB	'or.rgb=lerp(py/1000,p1.color.rgb,saturate(length(p)/30));', 0aH
	DB	'    p1.color.rgb=(1-py*2)/1.;', 0aH, '    p1.color.rgb=lerp(.'
	DB	'2*nebulaColor,.02*float3(1,2,3),1-girl);', 0aH, '        //p1'
