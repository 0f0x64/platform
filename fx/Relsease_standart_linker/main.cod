	DB	'    pos = rotY(pos, 45 * PI / 180.);', 0aH, '    pos = clamp('
	DB	'pos, -.5, .5)*6;', 0aH, 0aH, '    //---', 0aH, '    output.wp'
	DB	'os = float4(pos, 0);', 0aH, 0aH, '    pos = mul(pos, (float3x'
	DB	'3) view[0]);', 0aH, '    output.pos = mul(float4(pos, 1), pro'
	DB	'j[0]);', 0aH, '    ', 0aH, '    output.uv = grid.xy;', 0aH, ' '
	DB	'   return output;', 0aH, '}', 0aH, 00H	; `string'
