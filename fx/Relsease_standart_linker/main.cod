	DB	't skipper;', 0aH, '}', 0aH, 0aH, 'float4 transform2(float3 po'
	DB	's,float2 grid, float size)', 0aH, '{', 0aH, '    float2 uv = '
	DB	'grid-.5;', 0aH, '    float2 scale = float2(proj[0]._m00,proj['
	DB	'0]._m11);', 0aH, '    float4 posT;', 0aH, '    posT.w=1;', 0aH
	DB	'    posT.xyz = mul(pos/1.2, (float3x3)view[0]);', 0aH, 0aH, ' '
	DB	'       float4 pt = mul(posT, proj[0]);', 0aH, '        float2'
	DB	' sz = uv*.002*(posT.z/posT.w)*size;', 0aH, '        sz = uv*s'
	DB	'ize*.1;', 0aH, '        posT.xy+=sz;', 0aH, '        posT = m'
	DB	'ul(posT, proj[0]);', 0aH, 0aH, '        return posT;', 0aH, '}'
	DB	0aH, 0aH, 'float4 transform_unisize2(float3 pos,float2 grid,fl'
	DB	'oat size)', 0aH, '{', 0aH, '    float2 uv = grid-.5;', 0aH, ' '
	DB	'   float2 scale = float2(proj[0]._m00,proj[0]._m11);', 0aH, ' '
	DB	'   float4 posT;', 0aH, '    posT.w=1;', 0aH, '    posT.xyz = '
	DB	'mul(pos, (float3x3)view[0]);', 0aH, '        float4 pt = mul('
	DB	'posT, proj[0]);', 0aH, '        float2 sz = uv*.002*(posT.z/p'
	DB	'osT.w)*size;', 0aH, 0aH, '        sz*=normalize(scale)*2;', 0aH
	DB	'        posT = mul(posT, proj[0]);', 0aH, '        posT.xy+=s'
	DB	'z;', 0aH, 0aH, '        return posT;', 0aH, '}', 0aH, 0aH, 'p'
	DB	'os_color CalcParticles(uint qid, float4 grid)', 0aH, '{', 0aH
	DB	'    qid *= skipper;', 0aH, 0aH, '    float3 pos=shp(grid.xy);'
	DB	0aH, '    pos+=.7*rot3(pos,31/pos+.1*noise3(pos*3));', 0aH, ' '
	DB	'   pos=lerp(normalize(pos)*33,pos,.45);;', 0aH, '    ', 0aH, 0aH
	DB	0aH, '    pos_color p;', 0aH, 0aH, '    p.color = float4(float'
	DB	'3(3,6,9),1)*.051+.0015;', 0aH, 0aH, 0aH, '    if (mode==1)', 0aH
	DB	'    {', 0aH, '        //hilight', 0aH, '        p.pos=transfo'
	DB	'rm2(pos,grid.zw,302);', 0aH, '        p.color/=5;', 0aH, '   '
	DB	'     p.sz=2;', 0aH, '    }', 0aH, '    else', 0aH, '    {', 0aH
	DB	'        p.pos = transform_unisize2(pos,grid.zw,1.);', 0aH, ' '
	DB	'       p.sz=1;', 0aH, '        p.color*=3.8*(hash(qid))+.01;', 0aH
	DB	0aH, '        if (qid%8==0)', 0aH, '        {', 0aH, '        '
	DB	'    p.pos=transform2(pos,grid.zw,63);', 0aH, '            p.c'
	DB	'olor*=.051;', 0aH, '            p.sz=2;', 0aH, '        }', 0aH
	DB	'    } ', 0aH, 0aH, 0aH, '    ', 0aH, '    return p;', 0aH, '}'
	DB	0aH, 0aH, '#include <../lib/particleVS_main.shader>', 0aH, 00H ; `string'
