	DB	'float3(0,t,0))/6);', 0aH, '    pos+= noise3(pos)*.8;', 0aH, ' '
	DB	'   pos = rot3(pos,noise3(pos.zyx*1.6+float3(0,-t,0))/12);', 0aH
	DB	'    float3 pos3=pos;', 0aH, '    pos=(frac(pos/7)-.5)*14;', 0aH
	DB	'    //pos=lerp(pos,normalize(pos)*5+pos/2,saturate(length(pos'
