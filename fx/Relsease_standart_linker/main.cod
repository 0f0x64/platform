	DB	'd)*33+11;', 0aH, '        s=noise(iid)*62+11;', 0aH, '       '
	DB	' //s*=1.5;', 0aH, '        p.pos=transform(pos,grid.zw,s);', 0aH
	DB	'        p.color*=2.;', 0aH, '        p.sz=172;', 0aH, '    }', 0aH
	DB	'    else', 0aH, '    {', 0aH, '        p.pos = transform(pos,'
	DB	'grid.zw,1.2);', 0aH, '       //p.color=-noise(pos*.3+12)*.04+'
	DB	'.02;;', 0aH, '       // p.color +=min(0,sign(1./noise(-pos2*.'
	DB	'2-2.6)))/91.;', 0aH, '         p.sz=2;', 0aH, '         //p.c'
	DB	'olor*=1.2;', 0aH, 0aH, '         if (iid%inStars==0)', 0aH, ' '
	DB	'        {', 0aH, '              p.pos = transform_unisize(pos'
	DB	',grid.zw,75.5);', 0aH, '               p.sz=2;', 0aH, '      '
	DB	'         p.color*=7;', 0aH, '         }', 0aH, 0aH, '    }', 0aH
	DB	'      /*    if (iid==0)', 0aH, '         {', 0aH, '          '
	DB	'    p.pos = transform(0,grid.zw,16.5);', 0aH, '              '
	DB	' p.sz=2;', 0aH, '               p.color*=(float4(5,-.1,-1,1))'
	DB	';', 0aH, '               p.color*=10;', 0aH, '         }*/', 0aH
	DB	'  ', 0aH, '   ', 0aH, '    //density compensation', 0aH, '   '
	DB	' if (mode==0)', 0aH, '    {', 0aH, '    p.color*=1*saturate(p'
	DB	'.pos.w/27);', 0aH, '    //p.color*=0;', 0aH, 0aH, '    }', 0aH
	DB	0aH, '    if (mode==1)', 0aH, '    {', 0aH, '    p.color*=.3*s'
	DB	'aturate(21/p.pos.w);', 0aH, '    //p.color=.02;', 0aH, '    }'
