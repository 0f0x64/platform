	DB	'=r*noise3(r);r*=4;i=hash(b/1e3);r+=noise3(i*351*float3(4,25,6'
	DB	'7))*1.7;r=rot3(r,noise3(r*.8+float3(0,f,0))/6);r+=noise3(r)*.'
	DB	'8;r=rot3(r,noise3(r.zyx*1.6+float3(0,-f,0))/12);r=lerp(r,norm'
	DB	'alize(r)*10,saturate(length(r/37)));i=3;for(int f=0;f<32;f++)'
	DB	'{float4 b=(f+1)*float4(11,12,13,14)+time.x*.003;float3 x=floa'
	DB	't3(sin(b.x),cos(b.y),sin(b.z)*cos(b.w));x=normalize(x)*(8.3+.'
	DB	'5*sin(r+time.x*.01));i=3/length(r-x);r-=sign(f%3-.5)*normaliz'
	DB	'e(x-r)*pow(i,3);}r=lerp(r,normalize(r)*18+r/32,saturate(lengt'
	DB	'h(r/12)));return r/2;}pos_color CalcParticles(uint r,uint f,f'
	DB	'loat4 x){r*=skipper;float s=time.x*.004;uint b=10000;if(mode='
	DB	'=1||f%b==0)s=0;float3 i=pillar(r,f,x.xy,0,s,0),n=i;pos_color '
	DB	'e;e.color=float4(noise3_u(111+float3(113,11,111)*221+177+sin('
	DB	'n*.48)),1)/110.+.0015;e.color*=base_color/2;if(mode==1){float'
	DB	' r=hash(f)*23+11;e.pos=transform(i,x.zw,r);e.color*=.93;e.sz='
	DB	'172;}else{e.pos=transform_unisize(i,x.zw,1.75);e.sz=1;e.color'
	DB	'*=1.2;if(f%b==0)e.pos=transform_unisize(i,x.zw,151.5),e.sz=2,'
	DB	'e.color*=3;}return e;}', 0aH, '#include<../lib/particleVS_mai'
