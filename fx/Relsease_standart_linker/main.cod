	DB	'   return outp;', 0aH, '}', 0aH, 0aH, 'float tri(float x)', 0aH
	DB	'{', 0aH, '    return lerp(frac(x),1-frac(x),floor(frac(x/2)*2'
	DB	'));', 0aH, '}', 0aH, 0aH, 'float3 double_star(float2 grid,flo'
	DB	'at a, float t, float h,uint qid,uint star2)', 0aH, '{', 0aH, ' '
	DB	'   //float3 pos = float3(0,(grid.y-.5)*2,0);', 0aH, '    //fl'
