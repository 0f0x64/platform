	DB	's.y+=4;', 0aH, 0aH, '    pos.xz=toPolar(pos.xz);', 0aH, '    '
	DB	'pos.y-=noise(pos*10-float3(0,time.x/11,0))/6;', 0aH, '    pos'
	DB	'.y-=cellnoise(pos.xz/2-float2(0,time.x/100))/3;', 0aH, 0aH, ' '
	DB	'   pos.xz=fromPolar(pos.xz);', 0aH, '    pos.y-=noise(pos*5)/'
	DB	'3;', 0aH, '    pos.y*=-1;', 0aH, 0aH, '    if (iid%8==0)', 0aH
	DB	'    {', 0aH, '        pos.xz=noise3(iid/1334)*12+normalize(po'
	DB	's.xz)*14;', 0aH, 0aH, '        pos.xz/=3;', 0aH, '        pos'
	DB	'.y=0;', 0aH, '        pos+= noise3(pos*4)*.8;', 0aH, '       '
	DB	' pos.y+=cellnoise(pos.xz/14)*sign(pos.y)*2;', 0aH, '        p'
	DB	'os=rotY(pos,length(pos));', 0aH, '        //pos+= noise3(pos*'
	DB	'4)*.8;', 0aH, '        pos.y+=4;', 0aH, '        pos.y+=41/le'
	DB	'ngth(pos)-6;', 0aH, '        pos.x+=hash(iid)/2;', 0aH, 0aH, ' '
	DB	'   }else', 0aH, '    {', 0aH, '        pos+=hash3(iid)*length'
	DB	'(pos)/82;', 0aH, '    }', 0aH, 0aH, '    pos.y-=2;', 0aH, 0aH
	DB	'    return pos*2;', 0aH, '}', 0aH, 0aH, 0aH, 0aH, 'pos_color '
	DB	'CalcParticles(uint qid,uint iid,float4 grid)', 0aH, '{', 0aH, ' '
	DB	'    qid *= skipper;', 0aH, '     float t=time.x*.004;', 0aH, ' '
