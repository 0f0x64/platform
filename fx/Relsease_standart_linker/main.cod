	DB	'os=rot3(pos,t);', 0aH, '    return pos;', 0aH, '}', 0aH, 0aH, 'f'
	DB	'loat3 SphericalToCartesian(float3 p)', 0aH, '{', 0aH, '    fl'
	DB	'oat radius=p.x;', 0aH, '    float theta=p.y;', 0aH, '    floa'
	DB	't phi=p.z;', 0aH, '    float3 cartesian;', 0aH, '    // ', 0d0H
	DB	092H, ' HLSL ', 0d0H, 0beH, 0d0H, 0b1H, 0d1H, 08bH, 0d1H, 087H
	DB	0d0H, 0bdH, 0d0H, 0beH, ' Y ', 0e2H, 080H, 094H, ' ', 0d1H, 08dH
