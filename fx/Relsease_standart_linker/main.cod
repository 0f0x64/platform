	DB	'.color = float4(noise3_u(111+float3(113,11,111)*221+177+sin(p'
	DB	'os2*.48)),1)/90.+.0015;', 0aH, '    p.color*=base_color/3;', 0aH
	DB	'    p.color=lerp(p.color,p.color.bgra,.25+.5*sin(length(pos)*'
	DB	'2));', 0aH, '    //p.color=lerp(p.color,p.color.grba,.5+.5*co'
	DB	's(length(pos)*1.01+2));', 0aH, '    p.color.g+=.003;', 0aH, ' '
	DB	'   if (mode==1)', 0aH, '    {', 0aH, '        float s=hash(ii'
	DB	'd)*33+11;', 0aH, '        //s*=1.5;', 0aH, '        p.pos=tra'
	DB	'nsform(pos,grid.zw,s);', 0aH, '        p.color*=1.3;', 0aH, ' '
	DB	'       p.sz=172;', 0aH, '    }', 0aH, '    else', 0aH, '    {'
	DB	0aH, '        p.pos = transform_unisize(pos,grid.zw,1.75);', 0aH
	DB	'       //p.color=-noise(pos*.3+12)*.04+.02;;', 0aH, '       /'
	DB	'/ p.color +=min(0,sign(1./noise(-pos2*.2-2.6)))/91.;', 0aH, ' '
	DB	'        p.sz=1;', 0aH, '         p.color*=1.2;', 0aH, 0aH, ' '
	DB	'        if (iid%inStars==0)', 0aH, '         {', 0aH, '      '
	DB	'        p.pos = transform_unisize(pos,grid.zw,31.5);', 0aH, ' '
	DB	'              p.sz=2;', 0aH, '               p.color*=23;', 0aH
	DB	'         }', 0aH, 0aH, '    }', 0aH, '      /*    if (iid==0)'
	DB	0aH, '         {', 0aH, '              p.pos = transform(0,gri'
	DB	'd.zw,16.5);', 0aH, '               p.sz=2;', 0aH, '          '
	DB	'     p.color*=(float4(5,-.1,-1,1));', 0aH, '               p.'
	DB	'color*=10;', 0aH, '         }*/', 0aH, '  ', 0aH, '   ', 0aH, ' '
	DB	'   //density compensation', 0aH, '    //p.color/=min(pow(p.po'
	DB	's.w,1.1)*.21+.5,11);', 0aH, '    return p;', 0aH, '}', 0aH, 0aH
	DB	'#include <../lib/particleVS_main2.shader>', 0aH, 00H ; `string'
