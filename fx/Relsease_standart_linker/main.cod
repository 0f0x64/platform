	DB	'    }', 0aH, '    else', 0aH, '    {', 0aH, '        p.pos = '
	DB	'transform_unisize(pos,grid.zw,1.);', 0aH, '        p.sz=1;', 0aH
	DB	'        p.color*=3.8*(hash(qid))+.01;', 0aH, '    } ', 0aH, ' '
	DB	'   ', 0aH, '    return p;', 0aH, '}', 0aH, 0aH, 0aH, 0aH, 'po'
	DB	's_color floor_space(uint qid,float4 grid)', 0aH, '{', 0aH, ' '
	DB	'    uint glow = qid%11234;', 0aH, '     uint stars= qid%3400;'
	DB	0aH, '    uint cn=7;', 0aH, '    float a= (qid%cn);', 0aH, '  '
	DB	'  a=a*PI/180.;', 0aH, '    a*=360./cn;', 0aH, '    float t=ti'
