??_C@_0BFLK@EMLDHGBJ@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#in'
	DB	'clude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sh'
	DB	'ader>', 0aH, '#include <../lib/constants.shader>', 0aH, '#inc'
	DB	'lude <../lib/utils.shader>', 0aH, 0aH, 'cbuffer params : regi'
	DB	'ster(b0)', 0aH, '{', 0aH, '    float4x4 model;', 0aH, '    in'
	DB	't gX;', 0aH, '    int gY;', 0aH, '    int mode;', 0aH, '    i'
	DB	'nt skipper;', 0aH, '    float4 base_color;', 0aH, '}', 0aH, 0aH
	DB	'float toRad(float a)', 0aH, '{', 0aH, '    return a*PI/180.;', 0aH
	DB	'}', 0aH, 0aH, 'float quantize2(float x, float q)', 0aH, '{', 0aH
	DB	'    return floor(x*q)/q;', 0aH, '}', 0aH, 0aH, 'float3 torus('
	DB	'float u, float v, float R, float r) {', 0aH, '    float TWO_P'
	DB	'I = 6.283185307;', 0aH, '    float theta = u * TWO_PI/3; // A'
	DB	'ngle around the major ring', 0aH, '    float phi = v * TWO_PI'
	DB	';   // Angle around the minor tube', 0aH, 0aH, '    float x ='
	DB	' (R + r * cos(phi)) * cos(theta);', 0aH, '    float y = (R + '
	DB	'r * cos(phi)) * sin(theta);', 0aH, '    float z = r * sin(phi'
	DB	');', 0aH, 0aH, '    return float3(x, y, z);', 0aH, 0aH, '}', 0aH
	DB	0aH, 'float3 getTpos(float2 a, float R,float p,float q)', 0aH, '{'
	DB	'    ', 0aH, '        return float3((R + cos(a.x * q)) * cos(a'
	DB	'.x * p), ', 0aH, '                      (R + cos(a.x * q)) * '
	DB	'sin(a.x * p),', 0aH, '                      sin(a.x * q));', 0aH
	DB	'}', 0aH, 0aH, 'float3 torusKnot(float2 a)', 0aH, '{', 0aH, ' '
	DB	'   ', 0aH, '    float R = 3.5;', 0aH, '    float r = 3.;', 0aH
	DB	0aH, '    float p=1;', 0aH, '    float q=3.;', 0aH, 0aH, '    '
	DB	'float3 pos = getTpos(a,R,p,q);', 0aH, '    float3 T = pos - g'
	DB	'etTpos(a+float2(.01,0),R,p,q);', 0aH, '    float3 N = pos+T;', 0aH
	DB	'                    ', 0aH, '    float3 B = cross(T,N);', 0aH
	DB	'    N = cross(B,T);', 0aH, '    ', 0aH, '    B= normalize(B);'
	DB	0aH, '    N= normalize(N);', 0aH, '    float t=time.x/270;', 0aH
	DB	'    pos += r * (cos(a.y) * N + sin(a.y) * B);', 0aH, '    //p'
	DB	'os=rot3(pos,t);', 0aH, '    return pos;', 0aH, '}', 0aH, 0aH, 'f'
	DB	'loat3 SphericalToCartesian(float3 p)', 0aH, '{', 0aH, '    fl'
	DB	'oat radius=p.x;', 0aH, '    float theta=p.y;', 0aH, '    floa'
	DB	't phi=p.z;', 0aH, '    float3 cartesian;', 0aH, '    // ', 0d0H
	DB	092H, ' HLSL ', 0d0H, 0beH, 0d0H, 0b1H, 0d1H, 08bH, 0d1H, 087H
	DB	0d0H, 0bdH, 0d0H, 0beH, ' Y ', 0e2H, 080H, 094H, ' ', 0d1H, 08dH
	DB	0d1H, 082H, 0d0H, 0beH, ' ', 0d0H, 0b2H, 0d0H, 0b5H, 0d1H, 080H
	DB	0d1H, 085H, ' (Up), ', 0d0H, 0bfH, 0d0H, 0beH, 0d1H, 08dH, 0d1H
	DB	082H, 0d0H, 0beH, 0d0H, 0bcH, 0d1H, 083H, ':', 0aH, '    // x '
	DB	'= r * sin(phi) * cos(theta)', 0aH, '    // y = r * cos(phi)', 0aH
	DB	'    // z = r * sin(phi) * sin(theta)', 0aH, '    ', 0aH, '   '
	DB	' float sinPhi = sin(phi);', 0aH, '    ', 0aH, '    cartesian.'
	DB	'x = radius * sinPhi * cos(theta);', 0aH, '    cartesian.y = r'
	DB	'adius * cos(phi);', 0aH, '    cartesian.z = radius * sinPhi *'
	DB	' sin(theta);', 0aH, '    ', 0aH, '    return cartesian;', 0aH
	DB	'}', 0aH, 0aH, 'float3 CartesianToSpherical(float3 p)', 0aH, '{'
	DB	0aH, '    float radius = length(p);', 0aH, '    ', 0aH, '    /'
	DB	'/ ', 0d0H, 095H, 0d1H, 081H, 0d0H, 0bbH, 0d0H, 0b8H, ' ', 0d1H
	DB	082H, 0d0H, 0beH, 0d1H, 087H, 0d0H, 0baH, 0d0H, 0b0H, ' ', 0d0H
	DB	0b2H, ' ', 0d1H, 086H, 0d0H, 0b5H, 0d0H, 0bdH, 0d1H, 082H, 0d1H
	DB	080H, 0d0H, 0b5H, ' ', 0d0H, 0baH, 0d0H, 0beH, 0d0H, 0beH, 0d1H
	DB	080H, 0d0H, 0b4H, 0d0H, 0b8H, 0d0H, 0bdH, 0d0H, 0b0H, 0d1H, 082H
	DB	', ', 0d1H, 083H, 0d0H, 0b3H, 0d0H, 0bbH, 0d1H, 08bH, ' ', 0d0H
	DB	0bdH, 0d0H, 0b5H, ' ', 0d0H, 0beH, 0d0H, 0bfH, 0d1H, 080H, 0d0H
	DB	0b5H, 0d0H, 0b4H, 0d0H, 0b5H, 0d0H, 0bbH, 0d0H, 0b5H, 0d0H, 0bdH
	DB	0d1H, 08bH, 0aH, '    if (radius <= 0.0) return float3(0, 0, 0'
	DB	');', 0aH, 0aH, '    // theta = ', 0d1H, 083H, 0d0H, 0b3H, 0d0H
	DB	0beH, 0d0H, 0bbH, ' ', 0d0H, 0b2H, ' ', 0d0H, 0bfH, 0d0H, 0bbH
	DB	0d0H, 0beH, 0d1H, 081H, 0d0H, 0baH, 0d0H, 0beH, 0d1H, 081H, 0d1H
	DB	082H, 0d0H, 0b8H, ' XZ (', 0d0H, 0b0H, 0d0H, 0b7H, 0d0H, 0b8H, 0d0H
	DB	0bcH, 0d1H, 083H, 0d1H, 082H, ')', 0aH, '    // ', 0d0H, 098H, 0d1H
	DB	081H, 0d0H, 0bfH, 0d0H, 0beH, 0d0H, 0bbH, 0d1H, 08cH, 0d0H, 0b7H
	DB	0d1H, 083H, 0d0H, 0b5H, 0d0H, 0bcH, ' atan2(z, x) ', 0d0H, 0b4H
	DB	0d0H, 0bbH, 0d1H, 08fH, ' ', 0d0H, 0bfH, 0d0H, 0beH, 0d0H, 0bbH
	DB	0d0H, 0bdH, 0d0H, 0beH, 0d0H, 0b3H, 0d0H, 0beH, ' ', 0d0H, 0b4H
	DB	0d0H, 0b8H, 0d0H, 0b0H, 0d0H, 0bfH, 0d0H, 0b0H, 0d0H, 0b7H, 0d0H
	DB	0beH, 0d0H, 0bdH, 0d0H, 0b0H, ' [-PI, PI]', 0aH, '    float th'
	DB	'eta = atan2(p.z, p.x);', 0aH, '    ', 0aH, '    // phi = ', 0d1H
	DB	083H, 0d0H, 0b3H, 0d0H, 0beH, 0d0H, 0bbH, ' ', 0d0H, 0beH, 0d1H
	DB	082H, ' ', 0d0H, 0beH, 0d1H, 081H, 0d0H, 0b8H, ' Y (', 0d0H, 0b7H
	DB	0d0H, 0b5H, 0d0H, 0bdH, 0d0H, 0b8H, 0d1H, 082H, ') [0, PI]', 0aH
	DB	'    // acos ', 0d0H, 0b2H, 0d0H, 0beH, 0d0H, 0b7H, 0d0H, 0b2H
	DB	0d1H, 080H, 0d0H, 0b0H, 0d1H, 089H, 0d0H, 0b0H, 0d0H, 0b5H, 0d1H
	DB	082H, ' ', 0d0H, 0b7H, 0d0H, 0bdH, 0d0H, 0b0H, 0d1H, 087H, 0d0H
	DB	0b5H, 0d0H, 0bdH, 0d0H, 0b8H, 0d1H, 08fH, ' ', 0d0H, 0beH, 0d1H
	DB	082H, ' 0 ', 0d0H, 0b4H, 0d0H, 0beH, ' PI', 0aH, '    float ph'
	DB	'i = acos(p.y / radius);', 0aH, '    ', 0aH, '    return float'
	DB	'3(radius, theta, phi);', 0aH, '}', 0aH, 0aH, 'float3 pillar(u'
	DB	'int qid,uint iid,float2 grid,float a, float t, float h)', 0aH
	DB	'{', 0aH, '    float3 pos = float3(hash(iid/200.),hash(iid/140'
	DB	'.),hash(iid/120.))-.5;', 0aH, '    uint inStars = 1232*2;', 0aH
	DB	0aH, '    float3 pos3=pos;', 0aH, '    float l=hash(iid%15)*20'
	DB	'+20;', 0aH, '    pos=torusKnot(grid*PI*2);', 0aH, '    pos=ro'
	DB	't3(pos,pos/12);', 0aH, '    pos=rot3(pos,(iid%15)/3*float3(4,'
	DB	'5,6));', 0aH, '    ', 0aH, '    pos*=5.6;', 0aH, 0aH, '    po'
	DB	's+=rot3(pos,noise3(pos/10+1122));', 0aH, '    pos=rot3(pos,no'
	DB	'ise3(pos/5+1122)/5);', 0aH, '    pos+=noise3(pos/4+112)*6;', 0aH
	DB	0aH, '    float dst=3;', 0aH, '    for (int i=0;i<32;i++)', 0aH
	DB	'    {', 0aH, '        float4 j=(i+1)*float4(5,7,8,14)+time.x*'
	DB	'.01;', 0aH, '        float3 hole=float3(sin(j.x),cos(j.y),sin'
	DB	'(j.z)*cos(j.w));', 0aH, '        hole=normalize(hole)*62;', 0aH
	DB	'        dst=165/(distance(pos,hole));', 0aH, '        pos-=no'
	DB	'rmalize(hole-pos)*pow(dst,1);', 0aH, '    }', 0aH, 0aH, '    '
	DB	'pos=CartesianToSpherical(pos);', 0aH, '    pos.x+=noise3(pos/'
