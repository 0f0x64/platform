	DB	'    //pos=lerp(normalize(pos3)*10,pos,step(.3,saturate(length'
	DB	'(pos/33.5))));', 0aH, 'pos=lerp(normalize(pos3)*10,pos*1.6,st'
	DB	'ep(.3,saturate(length(pos/33.5))));', 0aH, '    pos+=noise3(p'
	DB	'os*12);', 0aH, '    pos+=noise3(pos*2)*46;', 0aH, '    //pos/'
