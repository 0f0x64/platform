	DB	'(a+1)+t)*.24;', 0aH, '    //pos = rotY(pos,length(pos)*2);', 0aH
	DB	'    //pos*=1+noise3(pos+1111/(a+1)+t)*.3;', 0aH, '    //pos*='
	DB	'1+noise3(pos*3.5)/5;', 0aH, '    ', 0aH, '    /*if (mode==0)', 0aH
	DB	'    {', 0aH, '        if (iid%5==0)', 0aH, '        {', 0aH, ' '
	DB	'           pos=pos3/40;', 0aH, '            pos*=1+noise(pos)'
	DB	'*6;', 0aH, '            pos=rot3(pos,pos*22+time.x*.05);', 0aH
	DB	'        }', 0aH, '    }*/', 0aH, 0aH, '    return pos*2;', 0aH
	DB	'}', 0aH, 0aH, 0aH, 0aH, 'pos_color CalcParticles(uint qid,uin'
	DB	't iid,float4 grid)', 0aH, '{', 0aH, '     qid *= skipper;', 0aH
	DB	'     float t=time.x*.004;', 0aH, '     uint inStars = 10000;', 0aH
	DB	'     if (mode==1||iid%inStars==0)', 0aH, '     {', 0aH, '    '
	DB	'    t=0;', 0aH, '     }', 0aH, 0aH, '    //pillars instances', 0aH
	DB	0aH, 0aH, '    //calc', 0aH, '    float3 pos = pillar(qid,iid,'
	DB	'grid.xy,0,t,0);', 0aH, '    float3 pos2=pos;', 0aH, '    ', 0aH
	DB	'    //scatter', 0aH, '    ', 0aH, '    //color', 0aH, '    po'
	DB	's_color p;', 0aH, '    p.color = float4(noise3_u(float3(113,1'
	DB	'15,1)*221+177+sin(pos2*.48)),1)/110.+.0015;', 0aH, '    p.col'
	DB	'or*=base_color/2;', 0aH, 0aH, '    if (mode==1)', 0aH, '    {'
	DB	0aH, '        float s=hash(iid)*33+11;', 0aH, '        p.pos=t'
	DB	'ransform(pos,grid.zw,s);', 0aH, '        p.color*=12;', 0aH, ' '
	DB	'       p.sz=172;', 0aH, '    }', 0aH, '    else', 0aH, '    {'
	DB	0aH, '        p.pos = transform_unisize(pos,grid.zw,1.5);', 0aH
	DB	'       //p.color=-noise(pos*.3+12)*.04+.02;;', 0aH, '       /'
	DB	'/ p.color +=min(0,sign(1./noise(-pos2*.2-2.6)))/91.;', 0aH, ' '
	DB	'        p.sz=1;', 0aH, 0aH, '         if (iid%inStars==0)', 0aH
	DB	'         {', 0aH, '              p.pos = transform_unisize(po'
	DB	's,grid.zw,151.5);', 0aH, '               p.sz=2;', 0aH, '    '
	DB	'           p.color*=3;', 0aH, '         }', 0aH, 0aH, '    }', 0aH
	DB	'      /*    if (iid==0)', 0aH, '         {', 0aH, '          '
	DB	'    p.pos = transform(0,grid.zw,16.5);', 0aH, '              '
	DB	' p.sz=2;', 0aH, '               p.color*=(float4(5,-.1,-1,1))'
	DB	';', 0aH, '               p.color*=10;', 0aH, '         }*/', 0aH
	DB	'  ', 0aH, '   ', 0aH, '    //density compensation', 0aH, '   '
