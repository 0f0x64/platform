	DB	',sign(1./noise(-pos2*.2-2.6)))/91.;', 0aH, '         p.sz=1;', 0aH
	DB	0aH, '         if (iid%inStars==0)', 0aH, '         {', 0aH, ' '
	DB	'             p.pos = transform_unisize(pos,grid.zw,151.5);', 0aH
	DB	'               p.sz=2;', 0aH, '               p.color*=3;', 0aH
	DB	'         }', 0aH, 0aH, '    }', 0aH, '      /*    if (iid==0)'
