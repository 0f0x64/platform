	DB	'(pos)/82;', 0aH, '    }', 0aH, 0aH, '    pos.y-=2;', 0aH, 0aH
	DB	'    return pos*2;', 0aH, '}', 0aH, 0aH, 0aH, 0aH, 'pos_color '
	DB	'CalcParticles(uint qid,uint iid,float4 grid)', 0aH, '{', 0aH, ' '
