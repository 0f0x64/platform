	DB	0aH, 0aH, 'float3 ACESFilm(float3 x)', 0aH, '{', 0aH, '    flo'
	DB	'at a = 2.51f;', 0aH, '    float b = 0.03f;', 0aH, '    float '
	DB	'c = 2.43f;', 0aH, '    float d = 0.59f;', 0aH, '    float e ='
	DB	' 0.14f;', 0aH, '    return saturate((x * (a * x + b)) / (x * '
	DB	'(c * x + d) + e));', 0aH, '}', 0aH, 0aH, 'float3 rotX(float3 '
	DB	'pos,float a)', 0aH, '{', 0aH, '    float3x3 m =', 0aH, '    {'
