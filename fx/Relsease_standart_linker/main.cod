	DB	'.00004+qid/1111.)*.07;', 0aH, '        pos+=noise3(g*.2+tm.x*'
	DB	'.05*dir)*scale2*1.51;', 0aH, '        pos+=noise3(grid.xyy*8+'
	DB	'dir*tm.x*.0001*+qid/41111.)*2.3*scale2;', 0aH, '        ', 0aH
	DB	'    }', 0aH, 0aH, '    return pos*2.5;', 0aH, '}', 0aH, 0aH, '/'
	DB	'*pos_color fish (uint qid,float div, float4 grid)', 0aH, '{', 0aH
	DB	'    pos_color outp;', 0aH, 0aH, '    //percentage', 0aH, '   '
	DB	' uint outer=262;', 0aH, '    uint star_2=4957;', 0aH, '    ui'
	DB	'nt big_hl=1111111203;', 0aH, 0aH, '    float t=time.x*.01;', 0aH
	DB	'    if (qid%outer==0||qid%big_hl==0||qid%star_2==0) t=0;', 0aH
	DB	0aH, '    //calc', 0aH, '    float3 pos = double_star(grid,0,t'
	DB	',0,qid,star_2);', 0aH, '//    pos = rot3(pos,float3(-.9,0,.4)'
	DB	');', 0aH, 0aH, '    //animation', 0aH, '    //pos+=noise(pos+'
	DB	'time.x*.05)*.125;', 0aH, '    ', 0aH, '    if (qid%outer==0) '
	DB	'pos = outer_space(pos, grid);', 0aH, '//    if (qid%floor_==0'
	DB	') pos = floor_space(pos2,grid,a);', 0aH, '  //  if (qid%star_'
	DB	'==0) pos = star(pos2*.7);', 0aH, 0aH, '    //camera', 0aH, ' '
	DB	'   float4 posT;', 0aH, 0aH, '   // if (qid%big_hl!=0)', 0aH, ' '
	DB	'   {', 0aH, '        posT = mul(float4(pos,1), view[0]);', 0aH
	DB	'        posT = mul(posT, proj[0]);', 0aH, '    }', 0aH, 0aH, ' '
	DB	'   //size', 0aH, '    float2 scale = float2(proj[0]._m00,proj'
	DB	'[0]._m11);', 0aH, '    float aspect_ = proj[0]._m11 / proj[0]'
	DB	'._m00;', 0aH, '    float2 gzw=(grid.zw-.5);//*(noise(sin(pos*'
	DB	'1.1)*11.5)*.3+.55);', 0aH, '    ', 0aH, '    ', 0aH, '    if '
	DB	'(qid%outer==0) gzw*=(qid%150)==0 ? abs(242*(noise(sin(pos*1.1'
	DB	')*1.5)))+3 :1.;', 0aH, '    if (qid%big_hl==0&&qid%outer!=0)', 0aH
	DB	'    {', 0aH, '        if (qid%outer==0) gzw*=42;', 0aH, '    '
	DB	'    else gzw*=42;', 0aH, '    }', 0aH, 0aH, '        posT = m'
	DB	'ul(float4(pos,1), view[0]);', 0aH, '        float4 pt = mul(p'
	DB	'osT, proj[0]);', 0aH, '        float2 sz = gzw*.002*(posT.z/p'
	DB	'osT.w);', 0aH, '        ', 0aH, '    if (qid%big_hl==0)', 0aH
	DB	'    {', 0aH, 0aH, '        ', 0aH, '        posT.xy+=sz;', 0aH
	DB	'        posT = mul(posT, proj[0]);', 0aH, '    }else', 0aH, ' '
	DB	'   {', 0aH, '        sz*=normalize(scale)*2;', 0aH, '        '
	DB	'posT = mul(posT, proj[0]);', 0aH, 0aH, '        posT.xy+=sz;', 0aH
	DB	'    }', 0aH, '    ', 0aH, '    ', 0aH, '    outp.sz=2;', 0aH, ' '
	DB	'   if (qid%outer==0&&qid%150!=0) ', 0aH, '    {', 0aH, '     '
	DB	'   outp.sz=1;', 0aH, '    }', 0aH, 0aH, '    outp.pos=posT;', 0aH
	DB	'    ', 0aH, '    //color', 0aH, 0aH, '    float dir=(qid%2-.5'
	DB	');', 0aH, '    float v=15;', 0aH, '    float q= .5+lerp(grid.'
	DB	'y,1-grid.y,qid%2)/2;', 0aH, '    q=.5+dir*(lerp(saturate((1-g'
	DB	'rid.y)*v),saturate(grid.y*v),qid%2));', 0aH, '    //float q= '
	DB	'saturate(.5+(1-grid.y)*v);', 0aH, '    //outp.color=float4(fl'
	DB	'oat3(.1,.1,.1)*noise3(pos*.1-.8),1)/3.5+.015;', 0aH, '    out'
	DB	'p.color=.0125*float4(lerp(float3(1,0.2,0.1),float3(0.1,0.2,1)'
	DB	',q)*(noise3(pos*1.1)*.5+.6),1);', 0aH, '    //outp.color=.5*f'
	DB	'loat4(lerp(float3(1,.1,.1),float3(.1,.1,1),q),1)/23.5-.001;', 0aH
	DB	'    //outp.color+=float4(lerp(float3(1,.1,.1),float3(.1,.1,1)'
	DB	',saturate(pos.yyy/4+.1)),1)/23.5-.001;', 0aH, 0aH, '    //if '
	DB	'(qid%big_hl==0) outp.color*=.35*1.5;', 0aH, 0aH, '    if (qid'
	DB	'%outer==0)', 0aH, '    {', 0aH, '        if (qid%123==0) outp'
	DB	'.color=2.6/(length(gzw)+1)*float4(4,5,6,1)/6;', 0aH, '       '
	DB	' else ', 0aH, '        outp.color+=.474*.7;     ', 0aH, '    '
	DB	'}', 0aH, '  ', 0aH, '   // outp.color/=posT.w/15+.1;', 0aH, ' '
	DB	'   //if (qid%star_2==0&&qid%big_hl!=0) outp.color=(noise(pos)'
	DB	'+1.2)*1.5;', 0aH, '     ', 0aH, '    outp.color*=1.;', 0aH, ' '
	DB	'   return outp;', 0aH, '}*/', 0aH, 0aH, 'VS_OUTPUT VS(uint vI'
	DB	'D : SV_VertexID,uint iID : SV_InstanceID)', 0aH, '{', 0aH, ' '
	DB	'   VS_OUTPUT output = (VS_OUTPUT) 0;', 0aH, '    float div=1;'
	DB	0aH, '    //float4 grid = getGridP(vID, 1, int2(gX,gY));', 0aH
	DB	'    float4 grid;', 0aH, '    float2 map[6] = { 0, 0, 1, 0, 1,'
	DB	' 1, 0, 0, 1, 1, 0, 1 };', 0aH, '    grid.zw= map[vID % 6];', 0aH
	DB	'    grid.xy= float2(iID % gX, floor(iID / gX))/float2(gX,gY);'
	DB	0aH, '    float2 uv = grid.xy;', 0aH, '    ', 0aH, '    uint q'
	DB	'id = iID;', 0aH, '    ', 0aH, '    pos_color p = sagittarius_'
	DB	'v2(qid,div,grid);', 0aH, '    ', 0aH, '    //density compensa'
	DB	'tion', 0aH, '   // p.color/=min(pow(p.pos.w,1.1)*.1+.5,11);', 0aH
	DB	'    ', 0aH, '    output.pos=p.pos;', 0aH, 0aH, '    output.vn'
	DB	'orm = 0;', 0aH, '    output.wpos = 0;', 0aH, '    output.vpos'
	DB	' = 0;', 0aH, '    output.uv = grid.zw;', 0aH, '    output.id '
	DB	'= float4(iID/div,0,0,0) ;', 0aH, '    output.color = p.color;'
	DB	0aH, '    output.sz1 = float4(p.sz,0,0,0);', 0aH, 0aH, '    re'
	DB	'turn output;', 0aH, '}', 0aH, 00H		; `string'
CONST	ENDS
;	COMDAT ??_C@_0HPD@CLFOPLGP@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
CONST	SEGMENT
??_C@_0HPD@CLFOPLGP@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#inc'
	DB	'lude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sha'
	DB	'der>', 0aH, '#include <../lib/constants.shader>', 0aH, '#incl'
	DB	'ude <../lib/utils.shader>', 0aH, 0aH, 'cbuffer params : regis'
	DB	'ter(b0)', 0aH, '{', 0aH, '    float4x4 model;', 0aH, '    int'
	DB	' gX;', 0aH, '    int gY;', 0aH, '    int mode;', 0aH, '    in'
	DB	't skipper;', 0aH, '}', 0aH, 0aH, 'pos_color CalcParticles(uin'
	DB	't qid, float4 grid)', 0aH, '{', 0aH, '   // grid.x=frac(grid.'
	DB	'x);', 0aH, '    float2 uv=grid.xy;', 0aH, '    uint cnt=42;', 0aH
	DB	'    uv=frac(uv*cnt);', 0aH, '    float b = quantize(grid.x,cn'
	DB	't);', 0aH, '    float ang=b*360.;', 0aH, '    float2 a = uv *'
	DB	' PI * 2;', 0aH, '    a.x *= -1;', 0aH, '    float3 pos = 0;', 0aH
	DB	'    float r=hash(b*3111.123)*6+7;', 0aH, '    r/=2;', 0aH, ' '
	DB	'   float central = qid%15;', 0aH, '    ', 0aH, 0aH, '        '
	DB	'pos.x-=r;', 0aH, '        float aaa=frac(a.y/PI+time.x*.0051*'
	DB	'(qid%3+1)+qid/900.)*PI*2;', 0aH, '        //aaa+=sin(aaa*6+ti'
	DB	'me.x+b*2222)*.1;', 0aH, '        //float aaa=(a.y+qid/100.);', 0aH
	DB	'        if (central!=0)', 0aH, '        {', 0aH, '           '
	DB	' pos=rotZ(pos,aaa);', 0aH, '        } else{', 0aH, '         '
	DB	'   pos=rotZ(pos,aaa/110);', 0aH, '            pos.y=(aaa-PI)*'
	DB	'10;', 0aH, '            pos.xz*=1+pow(abs(aaa-PI),7)*.0001;', 0aH
	DB	0aH, '        }', 0aH, '        pos.x+=r;', 0aH, 0aH, '       '
	DB	' if(central!=0)', 0aH, '        {', 0aH, '            pos+=ro'
	DB	't3(pos,ang*float3(1,2,3)+(length(pos)*.20)-time.x*.03);', 0aH
	DB	'            //pos+=rot3(pos,ang*float3(1,2,3)*b/(length(pos)*'
	DB	'.20+5)-time.x*.03);', 0aH, '            //pos+=rot3(pos,.1*an'
	DB	'g/(length(pos)*2)-time.x/30);', 0aH, 0aH, '        }', 0aH, 0aH
	DB	'    pos=rotY(pos,ang*PI/180.);', 0aH, '        ', 0aH, '    f'
	DB	'loat3 q= smoothstep(0,1,saturate(length(pos)/5*(1+abs(pos.y))'
	DB	'));', 0aH, '    pos=lerp(normalize(pos+noise3(float3(a,qid/10'
	DB	'00.)))*3,pos,q);', 0aH, '    pos*=2;', 0aH, '    pos+=(pos/12'
	DB	')/((noise3(qid*float3(1,2,3)/68.+222)+.6)+.1);', 0aH, '    //'
	DB	'pos+=length(pos/22)*(noise3(grid.xyx*float3(1,2,3)*75+222)+.6'
	DB	');', 0aH, 0aH, '    if(central==0)', 0aH, '    {', 0aH, '    '
	DB	'    pos=rotX(pos,.1);', 0aH, '    }', 0aH, 0aH, '    pos_colo'
	DB	'r p;', 0aH, 0aH, '    p.color = float4(float3(1,2,3),1)*.015+'
	DB	'.0015;', 0aH, 0aH, '    if (qid==0)', 0aH, '    {', 0aH, '   '
	DB	'     //central hilight', 0aH, '        p.color*=4.8;', 0aH, ' '
	DB	'       p.pos=transform(float3(0,0,0),grid.zw,552);', 0aH, '  '
	DB	'      p.sz=2;', 0aH, '    }', 0aH, '    else', 0aH, '    {', 0aH
	DB	'        p.pos = transform_unisize(pos/16,grid.zw,3.);', 0aH, ' '
	DB	'       p.sz=2;', 0aH, '        ', 0aH, '       // p.color*=11'
	DB	'/(abs(pos.y)*2+11.1);', 0aH, '    } ', 0aH, '    ', 0aH, '   '
	DB	' return p;', 0aH, '}', 0aH, 0aH, 0aH, 0aH, '#include <../lib/'
	DB	'particleVS_main.shader> ', 0aH, 00H		; `string'
CONST	ENDS
