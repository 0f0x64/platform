	DB	'sT = mul(float4(pos,1), view[0]);', 0aH, '        float4 pt ='
	DB	' mul(posT, proj[0]);', 0aH, '        float2 sz = uv*.002*(pos'
	DB	'T.z/posT.w)*size;', 0aH, '        sz = uv*size*.1;', 0aH, '  '
	DB	'      posT.xy+=sz;', 0aH, '        posT = mul(posT, proj[0]);'
	DB	0aH, 0aH, '        return posT;', 0aH, '}', 0aH, 0aH, 'float4 '
	DB	'transform_unisize(float3 pos,float2 grid,float size)', 0aH, '{'
	DB	0aH, '    float2 uv = grid-.5;', 0aH, '    float2 scale = floa'
	DB	't2(proj[0]._m00,proj[0]._m11);', 0aH, '    float4 posT;', 0aH
	DB	'    posT = mul(float4(pos,1), view[0]);', 0aH, '        float'
	DB	'4 pt = mul(posT, proj[0]);', 0aH, '        float2 sz = uv*.00'
	DB	'2*(posT.z/posT.w)*size;', 0aH, 0aH, '        sz*=normalize(sc'
	DB	'ale)*2;', 0aH, '        posT = mul(posT, proj[0]);', 0aH, '  '
