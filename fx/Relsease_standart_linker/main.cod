	DB	082H, ' ', 0d0H, 0b7H, 0d0H, 0bdH, 0d0H, 0b0H, 0d1H, 087H, 0d0H
	DB	0b5H, 0d0H, 0bdH, 0d0H, 0b8H, 0d1H, 08fH, ' ', 0d0H, 0beH, 0d1H
