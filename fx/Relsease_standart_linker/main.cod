	DB	'include <../lib/constBuf.shader>', 0aH, '#include <../lib/io.'
	DB	'shader>', 0aH, '#include <../lib/constants.shader>', 0aH, '#i'
	DB	'nclude <../lib/utils.shader>', 0aH, 0aH, 0aH, 'cbuffer params'
	DB	' : register(b0)', 0aH, '{', 0aH, '    int  gX,gY;', 0aH, '}', 0aH
	DB	0aH, 0aH, 0aH, 0aH, 'VS_OUTPUT VS(uint vID : SV_VertexID)', 0aH
	DB	'{', 0aH, '    VS_OUTPUT output = (VS_OUTPUT) 0;', 0aH, '    ', 0aH
	DB	'    float4 grid = getGrid(vID, 1, float2(gX, gY));', 0aH, '  '
	DB	'  float2 uv = grid.xy-.5;', 0aH, '    ', 0aH, '    float2 a ='
