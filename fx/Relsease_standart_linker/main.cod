	DB	'    return pos/2;', 0aH, '}', 0aH, 0aH, 0aH, 0aH, 'pos_color '
	DB	'CalcParticles(uint qid,uint iid,float4 grid)', 0aH, '{', 0aH, ' '
	DB	'    qid *= skipper;', 0aH, '     float t=time.x*.004;', 0aH, ' '
	DB	'    uint inStars = 10000;', 0aH, '     if (mode==1||iid%inSta'
	DB	'rs==0)', 0aH, '     {', 0aH, '        t=0;', 0aH, '     }', 0aH
	DB	0aH, '    //pillars instances', 0aH, 0aH, 0aH, '    //calc', 0aH
	DB	'    float3 pos = pillar(qid,iid,grid.xy,0,t,0);', 0aH, '    f'
	DB	'loat3 pos2=pos;', 0aH, '    ', 0aH, '    //scatter', 0aH, '  '
