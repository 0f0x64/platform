	DB	'os.y*=1.8;', 0aH, '   //pos*=1+noise3(pos*1.6+1111/(a+1)+t);', 0aH
	DB	'    pos = rot3(pos,2.2/(pow(pos,14)+1)+noise3(pos/2)*2);', 0aH
	DB	'    pos.y*=1.5;', 0aH, '    //pos*=1+noise3(pos+1111/(a+1)+t)'
	DB	';', 0aH, '    //pos*=1+noise3(pos*3.5)/3;', 0aH, '    pos*=2;'
	DB	0aH, '    //pos = rot3(pos,noise3(pos/3)*4+112);', 0aH, '    r'
	DB	'eturn pos;', 0aH, '}', 0aH, 0aH, 'pos_color CalcParticles(uin'
	DB	't qid,float4 grid)', 0aH, '{', 0aH, '    uint stars= qid%7345'
	DB	';', 0aH, '    uint cn=7;', 0aH, '    float a= (qid%cn);', 0aH
	DB	'    a=a*PI/180.;', 0aH, '    a*=360./cn;', 0aH, '    float t='
	DB	'time.x*.1;', 0aH, '    float3 pos = pillar(grid.xy,0,t*.005,.'
	DB	'5)/5;', 0aH, '    float3 pos2=pos;', 0aH, 0aH, '        pos.y'
	DB	'*=0;', 0aH, '        pos.xz*=9;', 0aH, '        pos.x*=.6;', 0aH
	DB	'        pos.y-=pow(length(pos.xz),.34)*7;', 0aH, '        ', 0aH
	DB	'        pos.y/=2;', 0aH, '        pos.y+=1.5;', 0aH, '       '
	DB	' //pos.xz+=1*pos.y*(qid%2-.5);', 0aH, '        pos.y*=-((qid%'
	DB	'2)-.5)*2;', 0aH, 0aH, '        pos+=noise3(pos-time.x/42)*sat'
	DB	'urate(length(pos)/4);', 0aH, '        pos=rot3(pos,noise3(pos'
	DB	'-time.x/72)/6);', 0aH, '        pos=rotY(pos,length(pos)*.3*('
	DB	'qid%2-.5)*2+a-time.x*.005*(qid%2-.5)*2);', 0aH, '        ', 0aH
	DB	'        pos=rotX(pos,1/pow(length(pos),2));', 0aH, '        p'
	DB	'os=rotZ(pos,14/pow(length(pos),4));', 0aH, 0aH, '        //po'
	DB	's+=noise3(qid*float3(1,2,3)*11.1)*2;', 0aH, 0aH, '        pos'
	DB	'_color p;', 0aH, '        float3 col_g=lerp(base_color.rgb,ba'
	DB	'se_color.bgr,pos.y/5+.5);', 0aH, '        p.color = float4(no'
	DB	'ise3_u(a*col_g+77+sin(pos2*11.4)),1)/50.+.00015;', 0aH, 0aH, ' '
	DB	'       if (stars==0)', 0aH, '        {', 0aH, '            p.'
	DB	'pos = transform_unisize(pos,grid.zw,42.);', 0aH, '           '
	DB	' p.sz=1;', 0aH, '        }', 0aH, '        else', 0aH, '     '
	DB	'   {', 0aH, '            if (mode==0)', 0aH, '            {', 0aH
	DB	'                float sz=1.1;', 0aH, '      ', 0aH, '        '
	DB	'        p.pos = transform_unisize(pos,grid.zw,sz);', 0aH, '  '
	DB	'              p.color*=float4(col_g,1)*1;', 0aH, '           '
	DB	'     p.sz=1;', 0aH, '            } ', 0aH, '            else', 0aH
	DB	'            {', 0aH, '                float sz=40;', 0aH, '  '
	DB	'              p.pos = transform(pos,grid.zw,sz);', 0aH, '    '
	DB	'            p.sz=2;', 0aH, '                p.color*=float4(c'
	DB	'ol_g,1)*pow(length(pos),3.)/4823;', 0aH, '            }', 0aH
	DB	'        }', 0aH, 0aH, '        if (mode!=0&&stars!=0)', 0aH, ' '
	DB	'       {', 0aH, '           // p.color.rgb*=noise(1*rotY(pos,'
	DB	'length(pos)-time.x*.005))*3.2+.012;', 0aH, 0aH, '        }', 0aH
	DB	0aH, '        ', 0aH, '        if (stars==0&&mode==0)', 0aH, ' '
	DB	'       {', 0aH, '            p.color*=34;', 0aH, '           '
	DB	' p.sz=2;', 0aH, '        }', 0aH, 0aH, '        if (qid==0)', 0aH
	DB	'        {', 0aH, '        p.pos=0;', 0aH, '        p.pos = tr'
	DB	'ansform(0,grid.zw,542);', 0aH, '        p.pos.y/=42;', 0aH, ' '
	DB	'       p.color*=float4(1,5,11,1)/3+pow(1/(length(pos)),2);', 0aH
	DB	'        }else', 0aH, '        {', 0aH, '            p.color*='
	DB	'1+pow(2/length(pos),2);', 0aH, '        }', 0aH, 0aH, '      '
	DB	'  //if (stars!=0&&mode==1) p.color*=2.5;', 0aH, '        //if'
	DB	' (stars!=0&&mode==0) p.color*=1.5;', 0aH, ' ', 0aH, 0aH, '   '
	DB	' //density compensation', 0aH, '  //  p.color/=min(pow(p.pos.'
	DB	'w,1.1)*.1+1.5,5);', 0aH, '//  p.color=pos.y/5+.5;  ', 0aH, ' '
	DB	' //p.color/=100;  ', 0aH, '  //p.color=saturate(p.color);', 0aH
	DB	'    return p;', 0aH, '} ', 0aH, 0aH, '#include <../lib/partic'
	DB	'leVS_main.shader>', 0aH, 00H		; `string'
CONST	ENDS
