	DB	'.5)*2;', 0aH, '    float y2=pow((smoothf(grid.y)-.5)*2,3);', 0aH
	DB	'    float y=lerp(y1,y2,0.);', 0aH, '    float3 pos = float3(0'
	DB	',y,0);', 0aH, '    ', 0aH, '    //pos=rot3(pos,grid.xyx*222);'
	DB	0aH, '    pos.z=0;', 0aH, '    float scale=sin(abs(grid.y-.5)*'
