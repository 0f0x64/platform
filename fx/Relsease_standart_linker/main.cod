	DB	'  );', 0aH, '    ofs2-=.5;', 0aH, '    ofs2=normalize(ofs2);', 0aH
	DB	'    ofs2.y-=.4;', 0aH, '    ofs2.y*=2;', 0aH, 0aH, '    pos.y'
	DB	'/=1.5;', 0aH, '    pos+=noise3(pos*253*grid.y+222)*pow(grid.y'
	DB	',2)/5;', 0aH, '    pos.y-=.25;', 0aH, '    float c2=1+saturat'
	DB	'e(-pos.y-.1)*22;', 0aH, '    ', 0aH, '    pos.y-=saturate(-po'
	DB	's.y-.1)*noise(pos*2+atan2(pos.x,pos.z)*3);', 0aH, '    pos.xz'
	DB	'*=c2;', 0aH, 0aH, '    pos.y-=.05;', 0aH, '    return pos*18;'
	DB	0aH, '}', 0aH, 0aH, 0aH, 0aH, 'pos_color CalcParticles(uint qi'
	DB	'd,uint iid,float4 grid)', 0aH, '{', 0aH, '     qid *= skipper'
	DB	';', 0aH, '     float t=time.x*.004;', 0aH, '     uint inStars'
