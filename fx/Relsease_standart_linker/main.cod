	DB	'        pos=rotZ(pos,(frac(abs(a.y)+time.x*.005)-.5)*.1);', 0aH
	DB	'        pos.x-=d;', 0aH, '        pos=rotY(pos,qid);', 0aH, ' '
	DB	'       pos.xz*=pos.xz;', 0aH, '    }', 0aH, 0aH, '    pos+=ro'
