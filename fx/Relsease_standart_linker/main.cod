	DB	'uv)', 0aH, '{', 0aH, '    float2 a = uv * PI * 2;', 0aH, '   '
	DB	' a.x *= -1;', 0aH, '    //float3 pos = float3(sin(a.x), (uv.y'
	DB	'-.5)*2, cos(a.x));', 0aH, '    float3 pos = float3(sin(a.x), '
	DB	'0, cos(a.x))*.1;', 0aH, '    pos=rot3(pos,noise3(float3(pos.x'
	DB	',uv.y,pos.z)*112));', 0aH, '    pos.y+=(uv.y-.5)*2;', 0aH, 0aH
	DB	'    return pos;', 0aH, '}', 0aH, 0aH, 0aH, 'float3 shp(float2'
	DB	' uv)', 0aH, '{', 0aH, '    float2 a = uv * PI * 2;', 0aH, '  '
