??_C@_0BHKF@GGKIHKLG@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#in'
	DB	'clude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sh'
	DB	'ader>', 0aH, '#include <../lib/constants.shader>', 0aH, '#inc'
	DB	'lude <../lib/utils.shader>', 0aH, 0aH, 'cbuffer params : regi'
	DB	'ster(b0)', 0aH, '{', 0aH, '    float4x4 model;', 0aH, '    in'
	DB	't gX;', 0aH, '    int gY;', 0aH, '    int mode;', 0aH, '    i'
	DB	'nt skipper;', 0aH, '    float4 base_color;', 0aH, '    float4'
	DB	' mesh[4000];', 0aH, '}', 0aH, 0aH, 'float toRad(float a)', 0aH
	DB	'{', 0aH, '    return a*PI/180.;', 0aH, '}', 0aH, 0aH, 'float '
	DB	'smin(float a, float b, float k) {', 0aH, '    float h = clamp'
	DB	'(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);', 0aH, '    return lerp('
	DB	'b, a, h) - k * h * (1.0 - h);', 0aH, '}', 0aH, 0aH, 'float3 h'
	DB	'ash33(float3 p)', 0aH, '{', 0aH, '    return float3(hash(p.x)'
	DB	',hash(p.y),hash(p.z))-.5;', 0aH, '}', 0aH, 0aH, 'float3 hash3'
	DB	'1(float p) {', 0aH, '   float3 p3 = frac(p * float3(.1031, .1'
	DB	'030, .0973));', 0aH, '   p3 += dot(p3, p3.yzx + 33.33);', 0aH
	DB	'   return frac((p3.xxy + p3.yzz) * p3.zyx); ', 0aH, '}', 0aH, 0aH
	DB	'float3 sm2(float x)', 0aH, '{', 0aH, '    return smoothstep(0'
	DB	',1,smoothstep(0,1,x));', 0aH, '}', 0aH, 0aH, 'float3 sm3(floa'
	DB	't3 x)', 0aH, '{', 0aH, '    return smoothstep(0,1,smoothstep('
	DB	'0,1,x));', 0aH, '}', 0aH, 0aH, 'float3 getRandomPointInTriang'
	DB	'le(float3 g, float3 g1, float3 g2, float r)', 0aH, '{', 0aH, ' '
	DB	'   float2 randoms;', 0aH, '    randoms.x = hash(r); ', 0aH, ' '
	DB	'   randoms.y = hash(randoms.x); ', 0aH, '    randoms.y = rand'
	DB	'oms.x/3;', 0aH, '    float sqrtR1 = sqrt(randoms.x);', 0aH, ' '
	DB	'   float u = 1.0f - sqrtR1;', 0aH, '    float v = randoms.y *'
	DB	' sqrtR1;', 0aH, '    return u * g + v * g1 + (1.0f - u - v) *'
	DB	' g2;', 0aH, '}', 0aH, 0aH, 'pos_color CalcParticles(uint qid,'
	DB	'uint iid,float4 grid)', 0aH, '{', 0aH, 0aH, 'float4 _ColorHot'
	DB	' = float4(1.0, 0.9, 0.7,1);', 0aH, 'float4 _ColorCold = float'
	DB	'4( 0.1, 0.0, 0.4,1);', 0aH, 0aH, 'float tm=(time.y-8*20*60);', 0aH
	DB	'tm=max(tm,0);', 0aH, 'float tl = 20*60;', 0aH, 'tm/=tl;', 0aH
	DB	'tm=1-tm;', 0aH, 0aH, 'float form=smoothstep(0,1,smoothstep(0,'
	DB	'1,.5+.5*sin(time.x/32)));', 0aH, 'form =sm2(tm);', 0aH, 'floa'
	DB	't3 pos;', 0aH, '    pos_color p1;', 0aH, 0aH, '    uint inSta'
	DB	'rs = 9623;', 0aH, '    float t = time.x * 1.;', 0aH, ' ', 0aH
	DB	'    // if (iid%inStars==0)', 0aH, '         {', 0aH, '       '
	DB	'      t=0;', 0aH, '         }', 0aH, '    float4 a = float4(1'
	DB	'.4 + sin(t*0.1)*0.1, -2.3, 2.4, -2.1 + cos(t*0.15)*0.1);', 0aH
	DB	'    float4 b = float4(0.8, -1.2 + sin(t*0.2)*0.05, 1.3, -1.5)'
	DB	';', 0aH, 0aH, '    float3 p = hash31((float)iid * 0.123) -.5;'
	DB	0aH, '    p=normalize(p)/1.5;', 0aH, '    float3 p_prev = p;', 0aH
	DB	'    ', 0aH, '    for (int i = 0; i < 18; i++) {', 0aH, '     '
	DB	'   p_prev = p;', 0aH, '        float3 next = noise3(p*8+22+a/'
	DB	'b);', 0aH, 0aH, '//        p -=next/(i+1);', 0aH, '  //      '
	DB	'p=rot3(p,p*(1-form));', 0aH, '    //    p+=(rot3(p-p/2,p*3)+p'
	DB	'/2)/11;', 0aH, '      //  p -= next/(i+1);', 0aH, 0aH, '     '
	DB	'   p -=next/(i+1)*(1-form);', 0aH, '        p=lerp(p,rot3(p,p'
	DB	'*3),(1-form));', 0aH, '        p+=(rot3(p-p/2,p*3)+p/2)/11*fo'
	DB	'rm;', 0aH, '        p -= next/(i+1)*form;', 0aH, 0aH, 0aH, ' '
	DB	'   }', 0aH, '    ', 0aH, '    p+=noise3(p*11+(time.x/32))/14*'
	DB	'saturate(length(p)/1);', 0aH, '    ', 0aH, '    float delta ='
	DB	' length(p - p_prev)*1;', 0aH, '    float heat = exp(-delta * '
	DB	'10); ', 0aH, 0aH, '    p*=12;', 0aH, '    //p=p.zxy*lerp(14,8'
	DB	',form);', 0aH, '    p=p.zxy*14;', 0aH, 0aH, '    float3 jitte'
	DB	'r = (hash31((float)iid) - 0.5) * 0.02;', 0aH, '    p += jitte'
	DB	'r/(pow(length(p),2)+.1)*172;', 0aH, '    float3 gp = p;', 0aH
	DB	'    float py = frac(iid/292100.-time.x/1000+hash(iid)/10);', 0aH
	DB	0aH, '    //int mln = 1504;', 0aH, '    int mln =3990;', 0aH, 0aH
	DB	0aH, '    float3 g=mesh[iid%mln]/4.8;', 0aH, '    float3 g_1=m'
	DB	'esh[(iid+hash(iid)*72)%mln]/4.8;', 0aH, '    float3 g_2=mesh['
	DB	'(iid+hash(iid)*2711)%mln]/4.8;', 0aH, '    float sd=.09;', 0aH
	DB	'    g_1=lerp(g_1,g,saturate(.1+distance(g,g_1)*sd));', 0aH, ' '
	DB	'   g_2=lerp(g_2,g,saturate(.1+distance(g,g_2)*sd/3.));', 0aH, 0aH
	DB	'    ', 0aH, 0aH, '    float3 f_0=mesh[iid%mln]/4.8;', 0aH, ' '
	DB	'   float3 f_1=mesh[(iid*21)%mln]/4.8;', 0aH, '    float3 f_2='
	DB	'mesh[(iid*471)%mln]/4.8;', 0aH, '    //sd=.09;', 0aH, '    f_'
