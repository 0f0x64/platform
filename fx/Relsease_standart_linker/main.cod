CONST	SEGMENT
??_C@_0CNB@NMOHKIGI@?6?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shad@ DB 0aH, '#'
	DB	'include <../lib/constBuf.shader>', 0aH, '#include <../lib/io.'
	DB	'shader>', 0aH, '#include <../lib/constants.shader>', 0aH, '#i'
	DB	'nclude <../lib/utils.shader>', 0aH, 0aH, 0aH, 'cbuffer params'
	DB	' : register(b0)', 0aH, '{', 0aH, '    int  gX,gY;', 0aH, '}', 0aH
	DB	0aH, 0aH, 0aH, 0aH, 'VS_OUTPUT VS(uint vID : SV_VertexID)', 0aH
	DB	'{', 0aH, '    VS_OUTPUT output = (VS_OUTPUT) 0;', 0aH, '    ', 0aH
	DB	'    float4 grid = getGrid(vID, 1, float2(gX, gY));', 0aH, '  '
	DB	'  float2 uv = grid.xy-.5;', 0aH, '    ', 0aH, '    float2 a ='
	DB	' uv * PI * 2;', 0aH, '    float3 pos = float3(sin(a.x), sin(a'
	DB	'.y / 2), cos(a.x));', 0aH, '    pos.xz *= cos(a.y / 2);', 0aH
	DB	'    pos = rotY(pos, 45 * PI / 180.);', 0aH, '    pos = clamp('
	DB	'pos, -.5, .5)*6;', 0aH, 0aH, '    //---', 0aH, '    output.wp'
	DB	'os = float4(pos, 0);', 0aH, 0aH, '    pos = mul(pos, (float3x'
	DB	'3) view[0]);', 0aH, '    output.pos = mul(float4(pos, 1), pro'
	DB	'j[0]);', 0aH, '    ', 0aH, '    output.uv = grid.xy;', 0aH, ' '
	DB	'   return output;', 0aH, '}', 0aH, 00H	; `string'
CONST	ENDS
;	COMDAT ??_C@_0PJB@DFFJMNHE@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
CONST	SEGMENT
??_C@_0PJB@DFFJMNHE@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#inc'
	DB	'lude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sha'
	DB	'der>', 0aH, '#include <../lib/constants.shader>', 0aH, '#incl'
	DB	'ude <../lib/utils.shader>', 0aH, 0aH, 'cbuffer params : regis'
	DB	'ter(b0)', 0aH, '{', 0aH, '    float4x4 model;', 0aH, '    int'
	DB	' gX;', 0aH, '    int gY;', 0aH, '    int mode;', 0aH, '    in'
	DB	't skipper;', 0aH, '    float4 base_color;', 0aH, '}', 0aH, 0aH
	DB	'float toRad(float a)', 0aH, '{', 0aH, '    return a*PI/180.;', 0aH
	DB	'}', 0aH, 0aH, 'float quantize2(float x, float q)', 0aH, '{', 0aH
	DB	'    return floor(x*q)/q;', 0aH, '}', 0aH, 0aH, 'float fastInv'
	DB	'Smoothstep(float x)', 0aH, '{', 0aH, '    return x + (x - (x '
	DB	'* x * (3.0 - 2.0 * x)));', 0aH, '}', 0aH, 0aH, 'float3 torus('
	DB	'float u, float v, float R, float r) {', 0aH, '    ', 0aH, '//'
	DB	'u = fastInvSmoothstep(u);', 0aH, 0aH, '    float TWO_PI = 6.2'
	DB	'83185307;', 0aH, '    float theta = u * TWO_PI/2; // Angle ar'
	DB	'ound the major ring', 0aH, '    float phi = v * TWO_PI;   // '
	DB	'Angle around the minor tube', 0aH, '    ', 0aH, '    //r+=pow'
	DB	'(sin(phi)+1,12)*pow(saturate(sin(theta*32)-.7)*4,1);', 0aH, ' '
	DB	'   //R+=pow(saturate(sin(theta*32)-.9)*4,4)*34;', 0aH, '//   '
	DB	' r+=pow(saturate(sin(phi)-.5),3)*pow(saturate(sin(theta*32)-.'
	DB	'8),1)*84;', 0aH, '    r*=pow(1-2*abs(u-.5),3);', 0aH, 0aH, ' '
	DB	'   r+=1/abs(sin(theta*20+time.x/12)+1.1)/22;', 0aH, '    r+=1'
	DB	'/abs(sin(phi+time.x/12)+1.1)*1/abs(sin(theta*17+time.x/12)+1.'
	DB	'1)/22;', 0aH, '    //r+=4*noise(phi*r*2+time.x/112)*noise(the'
	DB	'ta*r*2+time.x/112);    ', 0aH, '    ', 0aH, '    float x = (R'
	DB	' + r * cos(phi)) * cos(theta);', 0aH, '    float y = (R + r *'
	DB	' cos(phi)) * sin(theta);', 0aH, '    float z = r * sin(phi);', 0aH
	DB	0aH, '    return float3(x, y, z);', 0aH, '}', 0aH, 0aH, 'float'
	DB	'3 pillar(uint qid,uint iid,float2 grid,float a, float t, floa'
	DB	't h)', 0aH, '{', 0aH, '    float3 pos = float3(hash(iid/200.)'
	DB	',hash(iid/140.),hash(iid/120.))-.5;', 0aH, '    uint inStars '
	DB	'= 1232*2;', 0aH, 0aH, '    float3 pos3=pos;', 0aH, '    float'
	DB	' r2=pow(hash(iid%15),5)*23+22;', 0aH, '    float l=22;', 0aH, ' '
	DB	'   pos=torus(grid.x+hash(iid%7)/8,grid.y,l,1.);', 0aH, ' ', 0aH
	DB	'    ', 0aH, 0aH, '    //pos.x+=pow(hash(iid%15),5)*32;', 0aH, ' '
	DB	'   pos.y-=l*1.7;', 0aH, 0aH, '    pos=rot3(pos,iid%15/3*float'
	DB	'3(4,5,6)+noise3(pos/12+time.x/52)/15);', 0aH, 0aH, '    pos=r'
	DB	'ot3(pos,iid%6);', 0aH, 0aH, '    pos=lerp(normalize(pos3)*22,'
	DB	'pos,pow(smoothstep(0,1,saturate(length(pos/24))),5));', 0aH, ' '
	DB	'   pos+=hash3(iid/12)/3;', 0aH, 0aH, '    if (length(pos)<19)'
	DB	0aH, '    {', 0aH, '        pos=normalize(hash3(iid))*19*(1-no'
	DB	'ise(pos/25)/3);', 0aH, '        pos=rot3(pos,noise3(pos/3));', 0aH
	DB	'        pos=rot3(pos,noise3(pos/2)/5);', 0aH, '        //pos+'
	DB	'=noise(pos*5);', 0aH, '    }', 0aH, 0aH, '    return pos/4;', 0aH
	DB	0aH, '}', 0aH, 0aH, 0aH, 0aH, 'pos_color CalcParticles(uint qi'
	DB	'd,uint iid,float4 grid)', 0aH, '{', 0aH, '     qid *= skipper'
	DB	';', 0aH, '     float t=time.x*.004;', 0aH, '     uint inStars'
	DB	' = 1232*123;', 0aH, '     if (mode==1||iid%inStars==0)', 0aH, ' '
	DB	'    {', 0aH, '        t=0;', 0aH, '     }', 0aH, 0aH, '    //'
	DB	'pillars instances', 0aH, 0aH, 0aH, '    //calc', 0aH, '    fl'
	DB	'oat3 pos = pillar(qid,iid,grid.xy,0,t,0);', 0aH, '    float3 '
	DB	'pos2=pos;', 0aH, '    ', 0aH, '    //scatter', 0aH, '    ', 0aH
	DB	'    //color', 0aH, '    pos_color p;', 0aH, '    p.color.a=1;'
	DB	0aH, '    p.color.rgb = noise3_u(pos*14*float3(122,1,112))/31+'
	DB	'float3(6,2,3)/52;', 0aH, '    ', 0aH, '    p.color*=.5;', 0aH
	DB	'//    p.color*=base_color*(pow(length(pos)/16,4)+.1);', 0aH, ' '
	DB	'   //p.color*=1+sin(grid.x*PI*8);', 0aH, '    p.color=lerp(p.'
	DB	'color,p.color.bgra,sin(length(pos)));', 0aH, '//    p.color=l'
	DB	'erp(p.color,base_color/144,1-saturate(pow(length(pos)/6,11)))'
	DB	';', 0aH, 0aH, 0aH, '    if (mode==1)', 0aH, '    {', 0aH, '  '
	DB	'      float s=hash(iid)*33+11;', 0aH, '        s=noise(iid)*6'
	DB	'2+11;', 0aH, '        //s*=1.5;', 0aH, '        p.pos=transfo'
	DB	'rm(pos,grid.zw,s);', 0aH, '        p.color*=2.;', 0aH, '     '
	DB	'   p.sz=172;', 0aH, '    }', 0aH, '    else', 0aH, '    {', 0aH
	DB	'        p.pos = transform(pos,grid.zw,1.2);', 0aH, '       //'
	DB	'p.color=-noise(pos*.3+12)*.04+.02;;', 0aH, '       // p.color'
	DB	' +=min(0,sign(1./noise(-pos2*.2-2.6)))/91.;', 0aH, '         '
	DB	'p.sz=2;', 0aH, '         //p.color*=1.2;', 0aH, 0aH, '       '
	DB	'/*  if (iid%inStars==0)', 0aH, '         {', 0aH, '          '
	DB	'    p.pos = transform_unisize(pos,grid.zw,75.5);', 0aH, '    '
	DB	'           p.sz=2;', 0aH, '               p.color*=7;', 0aH, ' '
	DB	'        }*/', 0aH, 0aH, '    }', 0aH, '      /*    if (iid==0'
	DB	')', 0aH, '         {', 0aH, '              p.pos = transform('
	DB	'0,grid.zw,16.5);', 0aH, '               p.sz=2;', 0aH, '     '
	DB	'          p.color*=(float4(5,-.1,-1,1));', 0aH, '            '
	DB	'   p.color*=10;', 0aH, '         }*/', 0aH, '  ', 0aH, '   ', 0aH
	DB	'    //density compensation', 0aH, '    if (mode==0)', 0aH, ' '
	DB	'   {', 0aH, '    p.color*=1*saturate(p.pos.w/27);', 0aH, '   '
	DB	' //p.color*=0;', 0aH, '    ', 0aH, '    p.color*=-2;', 0aH, ' '
	DB	'   p.color/=saturate(length(pos)/3);', 0aH, '    p.color=max('
	DB	'p.color,-.03);', 0aH, '    }', 0aH, 0aH, '    if (mode==1)', 0aH
	DB	'    {', 0aH, '    p.color*=.3*saturate(21/p.pos.w);', 0aH, ' '
	DB	'   ', 0aH, '    p.color*=-1;', 0aH, '    p.color*=saturate(le'
	DB	'ngth(pos)/52);', 0aH, '    }', 0aH, '    ', 0aH, '    ', 0aH, 0aH
	DB	'   // p.color/=min(pow(p.pos.w,.5)*.1+1.5,5);', 0aH, '    ret'
	DB	'urn p;', 0aH, '}', 0aH, 0aH, '#include <../lib/particleVS_mai'
	DB	'n2.shader>', 0aH, 00H			; `string'
CONST	ENDS
;	COMDAT ??_C@_0BAJJ@BOKDPCAP@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
CONST	SEGMENT
??_C@_0BAJJ@BOKDPCAP@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#in'
	DB	'clude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sh'
	DB	'ader>', 0aH, '#include <../lib/constants.shader>', 0aH, '#inc'
	DB	'lude <../lib/utils.shader>', 0aH, 0aH, 'cbuffer params : regi'
