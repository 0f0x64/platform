	DB	'    {', 0aH, '        t=0;', 0aH, '     }', 0aH, 0aH, '    //'
	DB	'pillars instances', 0aH, 0aH, 0aH, '    //calc', 0aH, '    fl'
	DB	'oat3 pos = pillar(qid,iid,grid.xy,0,t,0);', 0aH, '    pos=rot'
	DB	'Z(pos,pos.y*length(pos)*sin(time.x/50)/280);', 0aH, 0aH, '   '
	DB	' float3 pos2=pos;', 0aH, '    ', 0aH, '    //scatter', 0aH, ' '
	DB	'   ', 0aH, '    //color', 0aH, '    pos_color p;', 0aH, '    '
	DB	'float4 prgba = float4(noise3_u(pos2/.4/2)*float3(3.4,3.5,1.),'
	DB	'1)/74.+float4(0,.015,0,0);', 0aH, '    float4 prgba2 = float4'
	DB	'(noise3_u(pos2/.4/2)*float3(1.4,.5,0.),1)/4.+.0015;    ', 0aH
	DB	'    p.color = lerp(prgba,prgba2,saturate(.1-pos.y/13));', 0aH
	DB	0aH, 0aH, '    if (mode==1)', 0aH, '    {', 0aH, '        p.po'
	DB	's=transform(pos,grid.zw,22);', 0aH, '        p.color*=pow(pos'
	DB	'.y+2,2)/20;', 0aH, '        p.sz=172;', 0aH, '    }', 0aH, ' '
	DB	'   else', 0aH, '    {', 0aH, '        p.pos = transform_unisi'
	DB	'ze(pos,grid.zw,1.5);', 0aH, '         p.sz=1;', 0aH, 0aH, '  '
	DB	'       if (iid%inStars==0)', 0aH, '         {', 0aH, '       '
	DB	'       p.pos = transform_unisize(pos,grid.zw,51.5);', 0aH, ' '
	DB	'              p.sz=2;', 0aH, '               p.color=float4(0'
	DB	',1,1,0)/3;', 0aH, '         }', 0aH, 0aH, '    }', 0aH, ' ', 0aH
	DB	'   ', 0aH, '    //density compensation', 0aH, '    //p.color/'
	DB	'=min(pow(p.pos.w,1.1)*.21+.5,11);', 0aH, '    return p;', 0aH
	DB	'}', 0aH, 0aH, '#include <../lib/particleVS_main2.shader>', 0aH
