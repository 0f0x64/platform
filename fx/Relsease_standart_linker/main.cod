	DB	'rs==0)', 0aH, '     {', 0aH, '        t=0;', 0aH, '     }', 0aH
	DB	0aH, '    //pillars instances', 0aH, 0aH, 0aH, '    //calc', 0aH
	DB	'    float3 pos = pillar(qid,iid,grid.xy,0,t,0);', 0aH, '    f'
	DB	'loat3 pos2=pos;', 0aH, '    ', 0aH, '    //scatter', 0aH, '  '
	DB	'  ', 0aH, '    //color', 0aH, '    pos_color p;', 0aH, '    p'
	DB	'.color = float4(noise3_u(float3(113,115,1)*221+177+sin(pos2*.'
