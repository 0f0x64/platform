	DB	'st *= 3.;', 0aH, 0aH, '    // Tile the space', 0aH, '    floa'
	DB	't2 i_st = floor(st);', 0aH, '    float2 f_st = frac(st);', 0aH
	DB	0aH, '    float m_dist = 1.;  // minimum distance', 0aH, 0aH, ' '
	DB	'   for (int y= -1; y <= 1; y++) {', 0aH, '        for (int x='
	DB	' -1; x <= 1; x++) {', 0aH, '            // Neighbor place in '
	DB	'the grid', 0aH, '            float2 neighbor = float2((x),(y)'
	DB	');', 0aH, 0aH, '            // Random position from current +'
	DB	' neighbor place in the grid', 0aH, '            float2 pt = r'
	DB	'andom2(i_st + neighbor);', 0aH, 0aH, 09H, 09H, 09H, '// Anima'
	DB	'te the point', 0aH, '            pt = 0.5 + 0.5*sin(0 + 6.283'
	DB	'1*pt);', 0aH, 0aH, 09H, 09H, 09H, '// Vector between the pixe'
	DB	'l and the point', 0aH, '            float2 diff = neighbor + '
	DB	'pt - f_st;', 0aH, 0aH, '            // Distance to the point', 0aH
	DB	'            float dist = length(diff);', 0aH, 0aH, '         '
	DB	'   // Keep the closer distance', 0aH, '            m_dist = m'
	DB	'in(m_dist, dist);', 0aH, '        }', 0aH, '    }', 0aH, 0aH, ' '
	DB	'   // Draw the min distance (distance field)', 0aH, '    colo'
	DB	'r += m_dist;', 0aH, '    return color.x;', 0aH, '}', 0aH, '//'
	DB	']', 0aH, 0aH, 'float2 toPolar(float2 pos)', 0aH, '{', 0aH, ' '
	DB	'   return float2(atan2(pos.y,pos.x),length(pos));', 0aH, '}', 0aH
	DB	0aH, 'float2 fromPolar(float2 pos)', 0aH, '{', 0aH, '    retur'
