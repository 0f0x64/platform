	DB	'/5;', 0aH, '    float3 pos2=pos;', 0aH, 0aH, '        pos.y*='
	DB	'.4*pow(length(pos),1)*4;', 0aH, '        pos.xz*=9;', 0aH, ' '
	DB	'       ', 0aH, '        pos=rotY(pos,length(pos)*.3+a+time.x*'
	DB	'.005);', 0aH, '        pos.y+=length(pos)/7;', 0aH, '        '
	DB	'pos.y-=4.5;', 0aH, '        ', 0aH, 0aH, '       pos+=noise3('
