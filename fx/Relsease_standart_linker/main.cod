	DB	'  ', 0aH, '    return p;', 0aH, '}', 0aH, 0aH, 'pos_color out'
	DB	'er_space(float3 pos,float4 grid, uint qid)', 0aH, '{', 0aH, 0aH
	DB	'    uint glow = qid%(64);', 0aH, 0aH, '    pos=shp(grid.xy);', 0aH
