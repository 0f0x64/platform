	DB	'    ', 0aH, 'float noise( float3 x ) {', 0aH, '    // The noi'
	DB	'se function returns a value in the range -1.0f -> 1.0f', 0aH, ' '
	DB	'   float3 p = floor(x);', 0aH, '    float3 f = frac(x);', 0aH
	DB	' ', 0aH, '    f = f*f*(3.0-2.0*f);', 0aH, '    float n = p.x '
	DB	'+ p.y*57.0 + 113.0*p.z;', 0aH, ' ', 0aH, '    float a= lerp(l'
	DB	'erp(lerp( hash(n+0.0), hash(n+1.0),f.x),', 0aH, '           l'
	DB	'erp( hash(n+57.0), hash(n+58.0),f.x),f.y),', 0aH, '          '
	DB	' lerp(lerp( hash(n+113.0), hash(n+114.0),f.x),', 0aH, '      '
	DB	'     lerp( hash(n+170.0), hash(n+171.0),f.x),f.y),f.z);', 0aH
	DB	'           return a-.5;', 0aH, '}', 0aH, 0aH, 'float3 noise3('
	DB	'float3 p)', 0aH, '{', 0aH, '    //return float3(noise(p.x),no'
	DB	'ise(p.y),noise(p.z));', 0aH, '    return float3(noise(p.xyz),'
	DB	'noise(p.yzx),noise(p.zxy));', 0aH, '}', 0aH, 0aH, 'float3 noi'
	DB	'se3_u(float3 p)', 0aH, '{', 0aH, '    //return float3(noise(p'
	DB	'.x),noise(p.y),noise(p.z));', 0aH, '    return float3(noise(p'
	DB	'.xyz),noise(p.yzx),noise(p.zxy))+.5;', 0aH, '}', 0aH, 0aH, 's'
	DB	'truct pos_color', 0aH, '{', 0aH, '    float4 pos;', 0aH, '   '
	DB	' float4 color;', 0aH, '    float sz;', 0aH, '};', 0aH, 0aH, 'f'
	DB	'loat hash_s(int qid)', 0aH, '{', 0aH, '    return hash(qid)-.'
	DB	'5;', 0aH, '}', 0aH, 0aH, 'float3 rot3(float3 pos, float3 angl'
