	DB	'}', 0aH, 0aH, 0aH, 'float3 pillar(float2 grid,float a, float '
	DB	't, float h)', 0aH, '{', 0aH, '    float3 pos = shp(grid.xy);', 0aH
	DB	'    //heigth', 0aH, '    pos.y*=.8+h;', 0aH, '    pos.y+=h;', 0aH
	DB	0aH, '    pos*=1+noise3(pos*111.6+1111/(a+1))*1.6;', 0aH, '   '
	DB	' pos.y*=1.8;', 0aH, '    pos*=1+noise3(pos*1.6+1111/(a+1)+t);'
	DB	0aH, '    pos = rot3(pos,2.2/(pow(pos,14)+1));', 0aH, '    pos'
	DB	'.y*=1.5;', 0aH, '    pos*=1+noise3(pos+1111/(a+1)+t);', 0aH, ' '
	DB	'   pos*=1+noise3(pos*3.5)/3;', 0aH, '    pos*=2;', 0aH, '    '
	DB	'return pos;', 0aH, '}', 0aH, 0aH, 'pos_color star(uint qid, f'
	DB	'loat4 grid)', 0aH, '{', 0aH, '    float2 uv=grid.xy;', 0aH, ' '
	DB	'   uint cnt=7;', 0aH, '    uv=frac(uv*cnt);', 0aH, '    float'
	DB	' b = quantize(grid.x,cnt);', 0aH, '    float ang=b*360.;', 0aH
	DB	'    float2 a = uv * PI * 2;', 0aH, '    a.x *= -1;', 0aH, '  '
	DB	'  float3 pos = 0;', 0aH, '    float r=18*hash(b)+1;', 0aH, ' '
	DB	'   ', 0aH, '    if (qid%12!=0)', 0aH, '    {', 0aH, '        '
	DB	'r=hash(b*3111.123)*18+4;', 0aH, '        pos+=7*noise3(qid*fl'
