	DB	0aH, '    pos.x=quantize2(grid.x,floor(yy.x))+.5/(floor(yy.x))'
	DB	';', 0aH, 0aH, '    float3 pos2 = float3(grid.x-.5,grid.y,0);', 0aH
	DB	0aH, '    pos2.x=quantize2(grid.x,floor(yy.y))+.5/(floor(yy.y)'
	DB	'); ', 0aH, 0aH, '    float q= frac(pow(grid.y,power)*branch_c'
	DB	'ount);', 0aH, 0aH, '    q=smoothstep(0,1,q);', 0aH, 0aH, '   '
	DB	' pos=lerp(pos,pos2,q);', 0aH, 0aH, '    pos.x-=.5;', 0aH, '  '
	DB	'  ', 0aH, '    float3 ofs3=float3(quantize2((grid.x),3)-.33,0'
	DB	',0);', 0aH, '    pos=ofs3+rotY(pos-ofs3,pow(grid.y,4)*(pos.x*'
	DB	'2+2));', 0aH, '    ', 0aH, '    pos.x/=2;', 0aH, '    pos=rot'
	DB	'Y(pos,sin(grid.y*12));', 0aH, 0aH, '    float3 ofs = float3(', 0aH
