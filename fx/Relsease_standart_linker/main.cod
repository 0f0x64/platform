	DB	't skipper;', 0aH, '}', 0aH, 0aH, 'float toRad(float a)', 0aH, '{'
	DB	0aH, '    return a*PI/180.;', 0aH, '}', 0aH, 0aH, 'float3 n3(u'
	DB	'int iid)', 0aH, '{', 0aH, '    float q=1;', 0aH, '    float a'
	DB	'=11234.123/q;', 0aH, '    float b=12345.234/q;', 0aH, '    fl'
	DB	'oat c=13456.345/q;', 0aH, '    float v1 = hash(iid/a);', 0aH, ' '
	DB	'   float v2 = hash(iid/b);', 0aH, '    float v3 = hash(iid/c)'
	DB	';', 0aH, '    return float3(v1,v2,v3);', 0aH, '}', 0aH, 0aH, 'f'
	DB	'loat quantize2(float x, float q)', 0aH, '{', 0aH, '    return'
	DB	' floor(x*q)/q;', 0aH, '}', 0aH, 0aH, 'float2 gety(float y, in'
	DB	't branch_count,float power)', 0aH, '{', 0aH, '    float s=2;', 0aH
	DB	'    float y2=pow(y,power);', 0aH, '    float y0=pow(s,floor(y'
	DB	'2*branch_count));', 0aH, '    float y1=pow(s,floor(y2*branch_'
	DB	'count)+1);', 0aH, '    return float2(y0,y1);', 0aH, '}', 0aH, 0aH
	DB	'float3 pillar(uint qid,uint iid,float2 grid,float a, float t,'
	DB	' float h)', 0aH, '{', 0aH, 0aH, 'float3 pos=0;', 0aH, 0aH, 'i'
	DB	'f (grid.y>.35)', 0aH, '{', 0aH, '    if (iid%5==0) {', 0aH, ' '
	DB	'       pos=float3(sin(grid.x*PI*2),(grid.y-.5)*2,cos(grid.x*P'
	DB	'I*2))/13;', 0aH, '        pos.y=-0.065;', 0aH, '    }', 0aH, ' '
	DB	'   else', 0aH, '    {', 0aH, '    float g=(grid.y-.35)*2.1;', 0aH
	DB	'    grid.x=quantize2(grid.x,3)+.1*sign(iid%2-.5);', 0aH, '   '
	DB	' pos=float3(sin(grid.x*PI*2),(1-grid.y)*8,cos(grid.x*PI*2))/1'
	DB	'8*float3(g,1,g);', 0aH, '    pos.y-=.065;', 0aH, '    }', 0aH
	DB	'    pos+=noise3(pos*22234.4+1222+time.x/22)*saturate(pos.y)/4'
	DB	';', 0aH, '    pos+=noise3(hash3(iid)*12.2)*.01;', 0aH, '}else'
	DB	0aH, '{', 0aH, '    grid.x+=sin(grid.x*2*PI-time.x/10)/4;', 0aH
	DB	'    pos=float3(sin(grid.x*PI*2),(grid.y-.5)*2,cos(grid.x*PI*2'
	DB	'));', 0aH, '    pos.xz*=.5-abs(grid.y-.5);', 0aH, '    pos=no'
	DB	'rmalize(pos);', 0aH, '    pos/=10;', 0aH, '    pos+=noise3(po'
	DB	's*614.4+222)/100;', 0aH, '    pos=rotY(pos,length(pos.xz)*222'
	DB	');', 0aH, 0aH, '}', 0aH, 0aH, 0aH, 'pos.x+=((iid%2)-.5)/1.9; '
	DB	0aH, 'pos.y-=.05;', 0aH, 0aH, 0aH, 0aH, '    return pos*18;', 0aH
	DB	'}', 0aH, 0aH, 0aH, 0aH, 'pos_color CalcParticles(uint qid,uin'
	DB	't iid,float4 grid)', 0aH, '{', 0aH, '     qid *= skipper;', 0aH
	DB	'     float t=time.x*.004;', 0aH, '     uint inStars = 10000;', 0aH
	DB	'     if (mode==1||iid%inStars==0)', 0aH, '     {', 0aH, '    '
	DB	'    t=0;', 0aH, '     }', 0aH, 0aH, 0aH, '    //calc', 0aH, ' '
	DB	'   float3 pos = pillar(qid,iid,grid.xy,0,t,0);', 0aH, '    po'
	DB	's.y+=iid%2==0 ? sin(time.x/50)/4 :-sin(time.x/50)/4;', 0aH, ' '
	DB	'   float3 pos2=pos;', 0aH, '    ', 0aH, '    //scatter', 0aH, ' '
	DB	'   ', 0aH, '    //color', 0aH, '    pos_color p;', 0aH, '    '
	DB	'p.color = float4(noise3_u(pos2/.1/3)*float3(7.4,2.5,0.),1)/14'
	DB	'.+.015;', 0aH, 0aH, '    p.color/=3;', 0aH, 0aH, '    if (mod'
	DB	'e==1)', 0aH, '    {', 0aH, '        p.pos=transform(pos,grid.'
	DB	'zw,22);', 0aH, '        p.color*=3;', 0aH, '        p.color*='
	DB	'pow(pos.y+2,2)/18;', 0aH, '        p.sz=172;', 0aH, '    }', 0aH
	DB	'    else', 0aH, '    {', 0aH, '        p.pos = transform_unis'
	DB	'ize(pos,grid.zw,1.5);', 0aH, '         p.sz=1;', 0aH, 0aH, ' '
	DB	'   }', 0aH, ' ', 0aH, '   ', 0aH, '    //density compensation'
	DB	0aH, '    //p.color/=min(pow(p.pos.w,1.1)*.21+.5,11);', 0aH, ' '
	DB	'   return p;', 0aH, '}', 0aH, 0aH, '#include <../lib/particle'
	DB	'VS_main2.shader>', 0aH, 00H			; `string'
CONST	ENDS
