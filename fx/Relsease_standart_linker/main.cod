	DB	'=SphericalToCartesian(pos); ', 0aH, '    ', 0aH, '    for (in'
	DB	't i=0;i<32;i++)', 0aH, '    {', 0aH, '        float4 j=(i+1)*'
	DB	'float4(5,7,8,14)+time.x*.01;', 0aH, '        float3 hole=floa'
	DB	't3(sin(j.x),cos(j.y),sin(j.z)*cos(j.w));', 0aH, '        hole'
	DB	'=normalize(hole)*62;', 0aH, '        dst=165/(distance(pos,ho'
	DB	'le));', 0aH, '        pos-=normalize(hole-pos)*pow(dst,1);', 0aH
	DB	'    }', 0aH, '    pos*=1-noise3(pos/5)*pow(length(pos)/422,3)'
	DB	';', 0aH, '    //pos*=1+1/noise3(pos/3)*pow(length(pos)/422,5)'
	DB	';', 0aH, '    ', 0aH, '    return pos/6;', 0aH, '}', 0aH, 0aH
	DB	0aH, 0aH, 'pos_color CalcParticles(uint qid,uint iid,float4 gr'
	DB	'id)', 0aH, '{', 0aH, '     qid *= skipper;', 0aH, '     float'
	DB	' t=time.x*.004;', 0aH, '     uint inStars = 1232*123;', 0aH, ' '
	DB	'    if (mode==1||iid%inStars==0)', 0aH, '     {', 0aH, '     '
