;	COMDAT ??_C@_0LAA@OOCHBFIC@?$CDinclude?5?$DM?4?4?1?4?4?1lib?1constBuf?4sh@
CONST	SEGMENT
??_C@_0LAA@OOCHBFIC@?$CDinclude?5?$DM?4?4?1?4?4?1lib?1constBuf?4sh@ DB '#'
	DB	'include <../../lib/constBuf.shader>', 0aH, '#include <../../l'
	DB	'ib/io.shader>', 0aH, '#include <../../lib/constants.shader>', 0aH
	DB	0aH, '//[', 0aH, 'cbuffer params : register(b0)', 0aH, '{', 0aH
	DB	'    float _aspect;', 0aH, '    float rad;', 0aH, '    float r'
	DB	', g, b, a;', 0aH, '    float soft;', 0aH, '    float edge;', 0aH
	DB	'    float outlineBrightness;', 0aH, '    float progress;', 0aH
	DB	'    float signed_progress;', 0aH, '    float slider_type;', 0aH
	DB	'}', 0aH, '//]', 0aH, 0aH, 'float2 rot(float2 pos,float a)', 0aH
	DB	'{', 0aH, '    float2x2 m =', 0aH, '    {', 0aH, '        cos('
	DB	'a), -sin(a),', 0aH, '        sin(a), cos(a)', 0aH, '    };', 0aH
	DB	'    return mul(pos, m);', 0aH, 0aH, '}', 0aH, 0aH, 'float rou'
	DB	'ndedBoxSDF(float2 CenterPosition, float2 Size, float Radius)', 0aH
	DB	'{', 0aH, '    return length(max(abs(CenterPosition) - Size + '
	DB	'Radius, 0.0)) - Radius;', 0aH, '}', 0aH, 0aH, 'float calcRA(f'
	DB	'loat2 uv, float2 sz, float radius)', 0aH, '{', 0aH, '    floa'
	DB	't2 ca = float2(1, aspect.x) ;', 0aH, '    float2 s = sz * ca;'
	DB	0aH, '    float r1 = (.001 + radius) * min(s.x, s.y);', 0aH, ' '
	DB	'   float r2 = roundedBoxSDF(uv*s, s*.5, r1)  / r1;', 0aH, '  '
	DB	'  return -r2;', 0aH, 0aH, '}', 0aH, 0aH, 'float4 PS(VS_OUTPUT'
	DB	'_POS_UV input) : SV_Target', 0aH, '{', 0aH, '    float4 color'
	DB	' = float4(r, g, b, a);', 0aH, '    ', 0aH, '    float2 uvs = '
	DB	'(input.uv - .5);', 0aH, 0aH, '    float signedProgress =0;', 0aH
	DB	'    float Progress =0;', 0aH, 0aH, '    if (slider_type==1)', 0aH
	DB	'    {', 0aH, '    Progress = progress < input.uv.x ? 0. : .12'
	DB	'5;', 0aH, '    Progress+=progress>0 ? abs(uvs.y)*saturate(pow'
	DB	'(saturate(1-2*abs(input.uv.x-progress)),28)) :0;', 0aH, '    '
	DB	'signedProgress = saturate(pow(saturate(1-2*abs(uvs.x-progress'
	DB	')),8));', 0aH, '    signedProgress*=4*pow(abs(uvs.x),2);', 0aH
	DB	'    }', 0aH, 0aH, '    if (slider_type==2)', 0aH, '    {', 0aH
	DB	'    float iuv = 1. - input.uv.y;', 0aH, '    Progress = progr'
	DB	'ess < iuv ? 0. : .125;', 0aH, '    Progress+=progress>0 ? (.4'
	DB	'+abs(uvs.x*2))*saturate(pow(saturate(1-2*abs(iuv-progress)),2'
	DB	'8)) :0;', 0aH, '    signedProgress = saturate(pow(saturate(1-'
	DB	'2*abs(uvs.y-progress)),8));', 0aH, '    signedProgress*=4*pow'
	DB	'(abs(uvs.y),2);', 0aH, '    ', 0aH, '    }', 0aH, 0aH, '    i'
	DB	'f (slider_type==3)', 0aH, '    {', 0aH, '    float2 uvsR = ro'
	DB	't(uvs,progress.x*PI*3/2);', 0aH, '    float ang = sign(satura'
	DB	'te(1.-28*abs(uvsR.x)));', 0aH, '    Progress = ang*saturate(s'
	DB	'ign(-uvsR.y-.2));', 0aH, '    Progress += saturate(1-25*abs(l'
	DB	'ength(uvs)-.45));', 0aH, '    //Progress *= saturate(1-2.5*le'
	DB	'ngth(uvs))*4;', 0aH, '    Progress *= (abs(atan2(uvs.x,uvs.y)'
	DB	')>PI/4.2)*.5;', 0aH, 0aH, '    float pAng = (sign(uvs.x)*sign'
	DB	'(progress.x));', 0aH, '    pAng*=saturate(-sign(progress.x)*s'
	DB	'ign(uvsR.x));', 0aH, '    pAng*=saturate(1-25*abs(length(uvs)'
	DB	'-.45));', 0aH, '    Progress +=saturate(pAng);', 0aH, 0aH, ' '
	DB	'   signedProgress = Progress;', 0aH, '    ', 0aH, '    }', 0aH
	DB	'  ', 0aH, '    ', 0aH, '    ', 0aH, '    Progress=lerp(Progre'
	DB	'ss,signedProgress,signed_progress);', 0aH, '   ', 0aH, '    c'
	DB	'olor += Progress-sign(slider_type)*.1;', 0aH, 0aH, '    float'
	DB	' d = calcRA(uvs, input.sz, rad);', 0aH, '    float embossMask'
	DB	' = sign(d) -saturate(d * edge * input.sz);', 0aH, '    float '
	DB	'emboss = embossMask * dot(atan(uvs - .1), -.25);', 0aH, '    '
	DB	'color.rgb += emboss;', 0aH, '    float2 s = input.sz;', 0aH, ' '
	DB	'   float m = min(s.x, s.y) / max(s.x, s.y);', 0aH, '    m *= '
	DB	'length(s);', 0aH, '    float outline = 1 - saturate(d * 8. * '
	DB	'sqrt(m)); // * float3(r, g, b);', 0aH, '    color.rgb += outl'
	DB	'ine*outlineBrightness;', 0aH, '    //return 1;', 0aH, '    re'
	DB	'turn float4(color.rgb, saturate(d*soft)*color.a);', 0aH, '}', 0aH
	DB	00H						; `string'
CONST	ENDS
;	COMDAT ??_C@_0CHI@MAKFIAGO@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
CONST	SEGMENT
??_C@_0CHI@MAKFIAGO@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#inc'
	DB	'lude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sha'
	DB	'der>', 0aH, '#include <../lib/utils.shader>', 0aH, 0aH, 0aH, 'T'
	DB	'exture2D screen : register(t0);', 0aH, 'Texture2D screenMid :'
	DB	' register(t1);', 0aH, 'Texture2D screenLow : register(t2);', 0aH
	DB	'SamplerState sam1 : register(s0);', 0aH, 0aH, 0aH, 'cbuffer p'
	DB	'arams : register(b0)', 0aH, '{', 0aH, '    float hilight;', 0aH
	DB	'};', 0aH, 0aH, 0aH, 0aH, 'float4 PS(VS_OUTPUT input, bool isF'
	DB	'rontFace : SV_IsFrontFace) : SV_Target', 0aH, '{', 0aH, '    '
	DB	'float4 c = screen.SampleLevel(sam1,input.uv,0);', 0aH, '    f'
	DB	'loat4 c2 = screenLow.SampleLevel(sam1,input.uv,0);', 0aH, '  '
	DB	'  float4 c3 = screenMid.SampleLevel(sam1,input.uv,0);', 0aH, ' '
	DB	'   c+=c2+c3;', 0aH, '   // c.b+=.25;', 0aH, '    c.rgb=ACESFi'
	DB	'lm(max(c.rgb,0)*.2);', 0aH, '    return float4(c.rgb,1);', 0aH
	DB	0aH, '}', 0aH, 00H				; `string'
CONST	ENDS
;	COMDAT ??_C@_0MKJ@KKAKOHON@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
CONST	SEGMENT
??_C@_0MKJ@KKAKOHON@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#inc'
	DB	'lude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sha'
	DB	'der>', 0aH, '#include <../lib/constants.shader>', 0aH, 0aH, 0aH
	DB	'cbuffer params : register(b0)', 0aH, '{', 0aH, '    float sx,'
	DB	'sy,sz;', 0aH, '};', 0aH, 0aH, 0aH, 'float3 rotX(float3 pos,fl'
	DB	'oat a)', 0aH, '{', 0aH, '    float3x3 m =', 0aH, '    {', 0aH
	DB	'        1, 0,       0,', 0aH, '        0, cos(a), -sin(a),', 0aH
	DB	'        0, sin(a), cos(a)', 0aH, '    };', 0aH, '    pos = mu'
	DB	'l(pos, m);', 0aH, '    return pos;', 0aH, '}', 0aH, 0aH, 'flo'
	DB	'at3 rotY(float3 pos, float a)', 0aH, '{', 0aH, '    float3x3 '
	DB	'm =', 0aH, '    {', 0aH, '        cos(a), 0, sin(a),', 0aH, ' '
	DB	'       0, 1, 0,', 0aH, '        -sin(a), 0, cos(a)', 0aH, '  '
	DB	'  };', 0aH, '    pos = mul(pos, m);', 0aH, '    return pos;', 0aH
	DB	'}', 0aH, 0aH, 'float3 rotZ(float3 pos, float a)', 0aH, '{', 0aH
	DB	'    float3x3 m =', 0aH, '    {', 0aH, '        cos(a), -sin(a'
	DB	'),0,', 0aH, '        sin(a), cos(a), 0,', 0aH, '        0, 0,'
	DB	' 1', 0aH, '    };', 0aH, '    pos = mul(pos, m);', 0aH, '    '
	DB	'return pos;', 0aH, '}', 0aH, 0aH, 'float calcWalls(float2 uv)'
	DB	0aH, '{', 0aH, '    float walls = 0;', 0aH, '    float2 uv5 = '
	DB	'float2(0, 0);', 0aH, '    for (int i = 0; i < 5; i++)', 0aH, ' '
	DB	'   {', 0aH, '  ', 0aH, '        float2 xy = uv - .5 - .5 * fl'
	DB	'oat2(sin(i * 4. + time.x * .01), .5*sin(i * 5. + time.x * .01'
	DB	'2));', 0aH, '        float2 uv4 = float2(atan2(xy.y, xy.x) * '
	DB	'2, 2 / (length(xy) - .1) + time.y * .1);', 0aH, '        //wa'
	DB	'lls += pow(saturate(1 - 2 * length(xy)), 2) * 12;', 0aH, '   '
	DB	'     uv5 += uv4*2;', 0aH, '        ', 0aH, '    }', 0aH, '  ', 0aH
	DB	'//  walls = pow((1 - 2 * (abs(sin(uv5.x)) * abs(sin(uv5.y / 1'
	DB	'3)))), 9) * 2;', 0aH, '    walls = pow((1 - 1 *(abs(sin(uv5.x'
	DB	')) * abs(sin(uv5.y / 13)))), 9) * 2;', 0aH, 0aH, '    return '
	DB	'walls;', 0aH, '}', 0aH, 0aH, 'float3 getTpos(float2 a, float '
	DB	'R,float p,float q)', 0aH, '{    ', 0aH, '        return float'
	DB	'3((R + cos(a.x * q)) * cos(a.x * p), ', 0aH, '               '
	DB	'       (R + cos(a.x * q)) * sin(a.x * p),', 0aH, '           '
	DB	'           sin(a.x * q));', 0aH, '}', 0aH, 0aH, 'float3 torus'
	DB	'Knot(float2 a)', 0aH, '{', 0aH, '    ', 0aH, '    float R = 3'
	DB	'.5;', 0aH, '    float r = 4.;', 0aH, 0aH, '    float p=3;', 0aH
	DB	'    float q=6;', 0aH, 0aH, '    float3 pos = getTpos(a,R,p,q)'
	DB	';', 0aH, '    float3 T = pos - getTpos(a+float2(.01,0),R,p,q)'
	DB	';', 0aH, '    float3 N = pos+T;', 0aH, '                    ', 0aH
	DB	'    float3 B = cross(T,N);', 0aH, '    N = cross(B,T);', 0aH, ' '
	DB	'   ', 0aH, '    B= normalize(B);', 0aH, '    N= normalize(N);'
	DB	0aH, 0aH, '    pos += r * (cos(a.y) * N + sin(a.y) * B);', 0aH
	DB	0aH, '    return pos;', 0aH, '}', 0aH, 0aH, 0aH, 'float3 spher'
	DB	'e(float2 uv)', 0aH, '{', 0aH, '    uv=frac(uv);', 0aH, '    ', 0aH
	DB	'    float2 a = uv * PI * 2;', 0aH, '    a.x *= -1;', 0aH, '  '
	DB	'  float3 pos = float3(sin(a.x), sin(a.y / 2), cos(a.x));', 0aH
	DB	'    pos.xz *= cos(a.y / 2);', 0aH, 0aH, '    pos *= .35;', 0aH
	DB	'    float wc = pow(calcWalls(sin((uv * PI) * float2(4, 3))), '
	DB	'.01);', 0aH, '    pos *= wc * .6 + 2;', 0aH, '    uv = abs(uv'
	DB	' - .5);', 0aH, '    pos /= 1 + .4 * ((sin(uv.x * PI * 2*2) * '
	DB	'cos(uv.y * PI * 4+time.y*.01))) ;', 0aH, '    pos *= 1.8;', 0aH
	DB	'    pos.y*=.5;', 0aH, '    pos.y-=.1*sin(length(pos.xz)*8+tim'
	DB	'e.x*.1);', 0aH, '   // pos=clamp(pos,-1,1);', 0aH, '  ', 0aH, ' '
	DB	'   pos.xyz=torusKnot(a);', 0aH, '    float3 pos1 = torusKnot('
	DB	'a+float2(-.01,0));', 0aH, '    float3 pos2 = torusKnot(a+floa'
	DB	't2(.01,0));', 0aH, '    float3 pos3 = torusKnot(a+float2(.0,-'
	DB	'.01));', 0aH, '    float3 pos4 = torusKnot(a+float2(.0,0.01))'
	DB	';', 0aH, '    float3 t =normalize(pos2-pos1.xyz);', 0aH, '   '
	DB	' float3 b =normalize(pos4-pos3.xyz);', 0aH, '    float3 n = c'
	DB	'ross(t,b);', 0aH, '    float a1= sin(a.x*PI*46/2)+sin(a.y*PI*'
	DB	'2/2);', 0aH, '    //a1*=sin(a.x+a.y)*.25;', 0aH, '    //a1=ab'
	DB	's(a1);', 0aH, '    float3 ofs= n*a1*.450+n*.1;', 0aH, '    //'
	DB	'ofs+= (t+b/5)*a1;', 0aH, '    //ofs*=.6;', 0aH, '    //pos+=o'
	DB	'fs*.7;', 0aH, '    //pos+=n*sin(pos*.033);', 0aH, 0aH, 0aH, '/'
	DB	'/    pos+=a1*float3(sin(pos.x*214),sin(pos.y*212),sin(pos.z*1'
	DB	'22))*.05;', 0aH, '  //  pos = rotZ(pos, time.x * 0.01);', 0aH
	DB	0aH, '    return pos;', 0aH, '}', 0aH, 0aH, 'float4 PS(VS_OUTP'
	DB	'UT input) : SV_Target', 0aH, '{', 0aH, '    float2 uv = input'
	DB	'.uv - .5;', 0aH, '    //uv.x-=time.x*.001;', 0aH, '    ', 0aH
	DB	'    float3 pos = sphere(uv)*2;', 0aH, '    //', 0aH, '    //r'
	DB	'eturn 1;', 0aH, '    return float4(pos, 1.);', 0aH, 0aH, '}', 0aH
	DB	00H						; `string'
CONST	ENDS
;	COMDAT ??_C@_0CME@LCPCJNLC@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
CONST	SEGMENT
??_C@_0CME@LCPCJNLC@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#inc'
	DB	'lude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sha'
	DB	'der>', 0aH, '#include <../lib/constants.shader>', 0aH, 0aH, 0aH
	DB	'Texture2D geo : register(t0);', 0aH, 'SamplerState sam1 : reg'
	DB	'ister(s0);', 0aH, 0aH, 0aH, 'float4 PS(VS_OUTPUT input) : SV_'
	DB	'Target', 0aH, '{', 0aH, '    uint sgX, sgY;', 0aH, '    geo.G'
	DB	'etDimensions(sgX, sgY);', 0aH, 0aH, '    float a = 1;', 0aH, ' '
	DB	'   sgY *= a;', 0aH, '    sgX *= a;', 0aH, '    float2 uv = in'
	DB	'put.uv;', 0aH, 0aH, '    float4 pt0 = geo.Sample(sam1, uv + f'
	DB	'loat2(-1. / sgX, 0));', 0aH, '    float4 pt1 = geo.Sample(sam'
	DB	'1, uv + float2(1. / sgX, 0));', 0aH, '    float4 pt2 = geo.Sa'
	DB	'mple(sam1, uv + float2(0, -1. / sgY));', 0aH, '    float4 pt3'
	DB	' = geo.Sample(sam1, uv + float2(0, 1. / sgY));', 0aH, '    fl'
	DB	'oat3 n = normalize(cross(pt0.xyz - pt1.xyz, pt2.xyz - pt3.xyz'
	DB	'));', 0aH, '    ', 0aH, '    float3 color = n;', 0aH, '    re'
	DB	'turn float4(color, 1);', 0aH, 0aH, '}', 0aH, 00H ; `string'
CONST	ENDS
;	COMDAT ??_C@_0BGM@KGCDIGBN@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
CONST	SEGMENT
??_C@_0BGM@KGCDIGBN@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#inc'
	DB	'lude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sha'
	DB	'der>', 0aH, '#include <../lib/utils.shader>', 0aH, 0aH, 0aH, 'T'
	DB	'extureCube env : register(t0);', 0aH, 'SamplerState sam1 : re'
	DB	'gister(s0);', 0aH, 0aH, 0aH, 'float4 PS(VS_OUTPUT input) : SV'
	DB	'_Target', 0aH, '{', 0aH, '    float4 color = env.SampleLevel('
	DB	'sam1, float4(normalize(input.wpos.xyz),0), 0);', 0aH, '    ', 0aH
	DB	'    color.rgb = pow(ACESFilm(color.rgb ), 1 / 2.2);', 0aH, ' '
	DB	'   return color;', 0aH, '}', 0aH, 00H	; `string'
CONST	ENDS
;	COMDAT ??_C@_0JDB@NDAEGBLB@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
CONST	SEGMENT
??_C@_0JDB@NDAEGBLB@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#inc'
	DB	'lude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sha'
	DB	'der>', 0aH, '#include <../lib/constants.shader>', 0aH, 0aH, 's'
	DB	'truct PS_OUTPUT', 0aH, '{', 0aH, '    float4 c0 : SV_Target0;'
	DB	0aH, '    float4 c1 : SV_Target1;', 0aH, '    float4 c2 : SV_T'
	DB	'arget2;', 0aH, '    float4 c3 : SV_Target3;', 0aH, '    float'
	DB	'4 c4 : SV_Target4;', 0aH, '    float4 c5 : SV_Target5;', 0aH, ' '
	DB	'   ', 0aH, '};', 0aH, 0aH, 'static const float3 offsetV[6] = '
	DB	'{ float3(1, 1, 1), float3(-1, 1, -1), float3(-1, 1, -1), floa'
	DB	't3(-1, -1, 1), float3(-1, 1, 1), float3(1, 1, -1) };', 0aH, 's'
	DB	'tatic const float3 offsetX[6] = { float3(0, 0, -2), float3(0,'
	DB	' 0, 2), float3(2, 0, 0), float3(2, 0, 0), float3(2, 0, 0), fl'
	DB	'oat3(-2, 0, 0) };', 0aH, 'static const float3 offsetY[6] = { '
	DB	'float3(0, -2, 0), float3(0, -2, 0), float3(0, 0, 2), float3(0'
	DB	', 0, -2), float3(0, -2, 0), float3(0, -2, 0) };', 0aH, 0aH, 'f'
	DB	'loat3 ConvertUV(float2 UV, int FaceIndex)', 0aH, '{', 0aH, ' '
	DB	'   float3 outV = offsetV[FaceIndex] + offsetX[FaceIndex] * UV'
	DB	'.x + offsetY[FaceIndex] * UV.y;', 0aH, '    return normalize('
	DB	'outV);', 0aH, '}', 0aH, 0aH, 'float calcWalls(float2 uv)', 0aH
	DB	'{', 0aH, '    float walls = 0;', 0aH, '    float2 uv5 = float'
	DB	'2(0, 0);', 0aH, '    for (int i = 0; i < 5; i++)', 0aH, '    '
	DB	'{', 0aH, '  ', 0aH, '        float2 xy = uv - .5 - .15 * floa'
	DB	't2(sin(i * 4. + time.x * .01), sin(i * 5. + time.x * .02));', 0aH
	DB	'        float2 uv4 = float2(atan2(xy.y, xy.x) * 1, 12 / (leng'
	DB	'th(xy) + .1) + time.y * .1);', 0aH, '        walls += pow(sat'
	DB	'urate(1 - 2 * length(xy)), 62) * 120;', 0aH, '        uv5 += '
	DB	'uv4;', 0aH, '        ', 0aH, '    }', 0aH, '    walls += pow('
	DB	'saturate(1 - 1 * (abs(sin(uv5.x)) * abs(sin(uv5.y / 13)))), 5'
	DB	') * 2;', 0aH, '    walls = walls * saturate(1 - 2 * length(uv'
	DB	' - .5));', 0aH, '    return walls;', 0aH, '}', 0aH, 0aH, 'flo'
	DB	'at4 env(float3 v)', 0aH, '{', 0aH, '    float a = .9*saturate'
	DB	'(1244*sin((v.z / v.y) * 6) * sin((v.x / v.y) * 6)) ;', 0aH, ' '
	DB	'   float blend = saturate(8 - pow(length(v.xz / v.y), .7));', 0aH
	DB	'    ', 0aH, '    float va = atan2(v.z, v.x);', 0aH, '    floa'
	DB	't x = frac(va / PI / 2 * 64);', 0aH, '    float y = frac((v.y'
	DB	') *10.+.5);', 0aH, '    ', 0aH, '    float b = saturate(1 - 2'
	DB	' * length(float2(x, y) - .5));', 0aH, '    ', 0aH, '    a = l'
	DB	'erp(a, b, 1-blend);', 0aH, '    a = pow(a, 24)*10;', 0aH, '  '
	DB	'  a *= saturate(-v.y);', 0aH, '    a += saturate(1 - 2 * leng'
	DB	'th(v.xz)) * saturate(v.y)*44;', 0aH, '    return float4(a, a,'
	DB	' a, 1);', 0aH, '}', 0aH, 0aH, 'PS_OUTPUT PS(VS_OUTPUT input) '
	DB	0aH, '{', 0aH, 0aH, '    float2 uv = input.uv;', 0aH, '    flo'
	DB	'at4 color = 1;//    float4(uv, 0, 1);', 0aH, 0aH, '    PS_OUT'
	DB	'PUT cube;', 0aH, '    ', 0aH, '    cube.c0 = env(ConvertUV(uv'
	DB	', 0));', 0aH, '    cube.c1 = env(ConvertUV(uv, 1));', 0aH, ' '
	DB	'   cube.c2 = env(ConvertUV(uv, 2));', 0aH, '    cube.c3 = env'
	DB	'(ConvertUV(uv, 3));', 0aH, '    cube.c4 = env(ConvertUV(uv, 4'
	DB	'));', 0aH, '    cube.c5 = env(ConvertUV(uv, 5));', 0aH, 0aH, ' '
	DB	'   return cube;', 0aH, '}', 0aH, 00H	; `string'
CONST	ENDS
;	COMDAT ??_C@_0BEIL@PBAOKJKN@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
CONST	SEGMENT
??_C@_0BEIL@PBAOKJKN@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#in'
	DB	'clude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sh'
	DB	'ader>', 0aH, '#include <../lib/constants.shader>', 0aH, 0aH, 0aH
	DB	'cbuffer params : register(b0)', 0aH, '{', 0aH, '    float sx,'
	DB	'sy,sz;', 0aH, '};', 0aH, 0aH, 0aH, 'float3 rotX(float3 pos,fl'
	DB	'oat a)', 0aH, '{', 0aH, '    float3x3 m =', 0aH, '    {', 0aH
	DB	'        1, 0,       0,', 0aH, '        0, cos(a), -sin(a),', 0aH
	DB	'        0, sin(a), cos(a)', 0aH, '    };', 0aH, '    pos = mu'
	DB	'l(pos, m);', 0aH, '    return pos;', 0aH, '}', 0aH, 0aH, 'flo'
	DB	'at3 rotY(float3 pos, float a)', 0aH, '{', 0aH, '    float3x3 '
	DB	'm =', 0aH, '    {', 0aH, '        cos(a), 0, sin(a),', 0aH, ' '
	DB	'       0, 1, 0,', 0aH, '        -sin(a), 0, cos(a)', 0aH, '  '
	DB	'  };', 0aH, '    pos = mul(pos, m);', 0aH, '    return pos;', 0aH
	DB	'}', 0aH, 0aH, 'float3 rotZ(float3 pos, float a)', 0aH, '{', 0aH
	DB	'    float3x3 m =', 0aH, '    {', 0aH, '        cos(a), -sin(a'
	DB	'),0,', 0aH, '        sin(a), cos(a), 0,', 0aH, '        0, 0,'
	DB	' 1', 0aH, '    };', 0aH, '    pos = mul(pos, m);', 0aH, '    '
	DB	'return pos;', 0aH, '}', 0aH, 0aH, 'float calcWalls(float2 uv)'
	DB	0aH, '{', 0aH, '    float walls = 0;', 0aH, '    float2 uv5 = '
	DB	'float2(0, 0);', 0aH, '    for (int i = 0; i < 5; i++)', 0aH, ' '
	DB	'   {', 0aH, '  ', 0aH, '        float2 xy = uv - .5 - .5 * fl'
	DB	'oat2(sin(i * 4. + time.x * .01), .5*sin(i * 5. + time.x * .01'
	DB	'2));', 0aH, '        float2 uv4 = float2(atan2(xy.y, xy.x) * '
	DB	'2, 2 / (length(xy) - .1) + time.y * .1);', 0aH, '        //wa'
	DB	'lls += pow(saturate(1 - 2 * length(xy)), 2) * 12;', 0aH, '   '
	DB	'     uv5 += uv4*2;', 0aH, '        ', 0aH, '    }', 0aH, '  ', 0aH
	DB	'//  walls = pow((1 - 2 * (abs(sin(uv5.x)) * abs(sin(uv5.y / 1'
	DB	'3)))), 9) * 2;', 0aH, '    walls = pow((1 - 1 *(abs(sin(uv5.x'
	DB	')) * abs(sin(uv5.y / 13)))), 9) * 2;', 0aH, 0aH, '    return '
	DB	'walls;', 0aH, '}', 0aH, 0aH, 'float3 getTpos(float2 a, float '
	DB	'R,float p,float q)', 0aH, '{    ', 0aH, '        return float'
	DB	'3((R + cos(a.x * q)) * cos(a.x * p), ', 0aH, '               '
	DB	'       (R + cos(a.x * q)) * sin(a.x * p),', 0aH, '           '
	DB	'           sin(a.x * q));', 0aH, '}', 0aH, 0aH, 'float3 torus'
	DB	'Knot(float2 a)', 0aH, '{', 0aH, '    ', 0aH, '    float R = 1'
	DB	'.5;', 0aH, '    float r = .24;', 0aH, 0aH, '    float p=1;', 0aH
	DB	'    float q=3;', 0aH, 0aH, '    float3 pos = getTpos(a,R,p,q)'
	DB	';', 0aH, '    float3 T = pos - getTpos(a+float2(.01,0),R,p,q)'
	DB	';', 0aH, '    float3 N = pos+T;', 0aH, '                    ', 0aH
	DB	'    float3 B = cross(T,N);', 0aH, '    N = cross(B,T);', 0aH, ' '
	DB	'   ', 0aH, '    B= normalize(B);', 0aH, '    N= normalize(N);'
	DB	0aH, 0aH, '    pos += r * (cos(a.y) * N + sin(a.y) * B);', 0aH
	DB	0aH, '    return pos;', 0aH, '}', 0aH, 0aH, 'static float lcoe'
	DB	'f=0;', 0aH, 'static float3 sym=float3(0,0,0);', 0aH, 0aH, 'vo'
	DB	'id select(float2 pos,float2 modPos,float rad, float p)', 0aH, '{'
	DB	0aH, '    float coef = rad/distance(pos,modPos);', 0aH, '    c'
	DB	'oef=smoothstep(0,1,coef);', 0aH, '    lcoef=pow(coef,p);', 0aH
	DB	'}', 0aH, 0aH, 'float2 density(float2 pos,float2 modPos,float '
	DB	'rad,float p)', 0aH, '{', 0aH, '    select(pos,modPos,rad, p);'
	DB	0aH, '    return lerp(pos,modPos,lcoef*.9);', 0aH, '}', 0aH, 0aH
	DB	'void select(float3 pos,float3 modPos,float rad, float p)', 0aH
	DB	'{', 0aH, '    float3 sPos = lerp(pos,abs(pos),sym);', 0aH, ' '
	DB	'   float3 sModPos = lerp(modPos,abs(modPos),sym);', 0aH, '   '
	DB	' float coef = rad/distance(sPos,sModPos);', 0aH, '    coef=sm'
	DB	'oothstep(0,1,coef);', 0aH, '    lcoef=pow(coef,p);', 0aH, '}', 0aH
	DB	0aH, 'float3 move(float3 pos,float3 ofs)', 0aH, '{', 0aH, '   '
	DB	' float3 newpos = lerp(pos,pos+ofs,lcoef);', 0aH, '    return '
	DB	'newpos;', 0aH, '}', 0aH, 0aH, 'float3 zoom(float3 pos,float3 '
	DB	'modPos, float3 ofs)', 0aH, '{', 0aH, '    float3 newpos = ler'
	DB	'p(pos,(pos-modPos)*ofs+modPos,lcoef);', 0aH, '    return newp'
	DB	'os;', 0aH, '}', 0aH, 0aH, 'float3 sphere(float2 uv)', 0aH, '{'
	DB	0aH, 0aH, 0aH, '    float2 a = (uv-.5) * PI * 2;', 0aH, '   //'
	DB	' a.x *= -1;', 0aH, '    ', 0aH, '    float R = 1;', 0aH, '   '
	DB	' float3 pos = float3(R*sin(a.x), a.y / 4, R*cos(a.x));', 0aH, ' '
	DB	'   pos.xz *= cos(a.y/2 );', 0aH, '    pos=normalize(pos);', 0aH
	DB	'    pos = pos.yxz;', 0aH, '    ', 0aH, '    float3 mpos = flo'
	DB	'at3(0.,-.8,0.);', 0aH, '    ', 0aH, '    select(pos,mpos,.2,1'
	DB	');', 0aH, 0aH, 0aH, '  pos=lerp(pos,mpos+(1+.2-distance(pos,m'
	DB	'pos))*normalize(pos-mpos),lcoef);', 0aH, 0aH, '    //pos=lerp'
	DB	'(pos,normalize(pos-mpos)*4+mpos,lcoef);', 0aH, '    //pos = l'
	DB	'erp(pos,mpos,lcoef*length(normalize(pos-mpos)));', 0aH, 0aH, ' '
	DB	'  // pos=rotZ(pos,pos.x);', 0aH, 0aH, ' //   pos.z*=2;', 0aH, ' '
	DB	' //  pos.x*=.35;', 0aH, '   // pos.y*=.35;', 0aH, 0aH, '//pos'
	DB	'= move(pos,float3(0,-1,0));', 0aH, 0aH, 0aH, '    sym=float3('
	DB	'0,0,0);', 0aH, '    select(pos,float3(0,0,2.3),.4,3);', 0aH, '/'
	DB	'/    pos = zoom(pos,float3(0,0,2.2),float3(3,3,1.3));', 0aH, ' '
	DB	'  ', 0aH, '    //head and neck', 0aH, '    select(pos,float3('
	DB	'0,0,2.3),.7,1.2);', 0aH, ' //   pos = rotX(pos,lcoef*.2);', 0aH
	DB	'//    pos = move(pos,float3(0,lcoef*.3,-lcoef*.1));', 0aH, 0aH
	DB	'    //tail', 0aH, '   select(pos,float3(.0,0.,-1.6),.9,25);', 0aH
	DB	' //   pos = zoom(pos,float3(.0,0.,-1.6),float3(.2,.2,1));', 0aH
	DB	'    select(pos,float3(.0,0.,-1.6),.9,11);', 0aH, '  //  pos=r'
	DB	'otX(pos,-1.8*sin(pos.z*1+3.5)*lcoef);', 0aH, '  //   pos=rotY'
	DB	'(pos,-.8*sin(pos.z*1+3.5)*lcoef);', 0aH, '     //tail ainm', 0aH
	DB	'    select(pos,float3(.0,1.8,-1.2),.6,11);', 0aH, '    //pos='
	DB	'rotY(pos,-1.8*sin(time.x*.1)*lcoef);', 0aH, '     //pos=rotY('
	DB	'pos,-.8*sin(pos.z*1+3.5)*lcoef);', 0aH, '     //pos = move(po'
	DB	's,float3(0,0,-4));', 0aH, 0aH, 0aH, '    sym=float3(1,0,0);', 0aH
	DB	'   select(pos,float3(.15,-.1,1.),.13,8);', 0aH, '  //  pos = '
	DB	'move(pos,float3(0,-.7,0));', 0aH, '    lcoef=pow(lcoef,.2);', 0aH
	DB	'  //  pos = zoom(pos,float3(0,0,0.),float3(1.5,1,1));', 0aH, 0aH
	DB	'    sym=float3(1,0,0);', 0aH, '     select(pos,float3(.35,-.1'
	DB	',-.4),.15,5);', 0aH, '    //pos = move(pos,float3(0,-.7,0));', 0aH
	DB	'    lcoef=pow(lcoef,.2);', 0aH, '//    pos = zoom(pos,float3('
	DB	'0,0,0.),float3(1.5,1,1));', 0aH, 0aH, '    //pos.xz*=.7;', 0aH
	DB	0aH, '    return pos;', 0aH, '}', 0aH, 0aH, 'float4 PS(VS_OUTP'
	DB	'UT input) : SV_Target', 0aH, '{', 0aH, '    float2 uv = input'
	DB	'.uv;', 0aH, '    //uv.x-=time.x*.001;', 0aH, '    ', 0aH, '  '
	DB	'   float2 a = (uv-.5) * PI * 2;', 0aH, '    a.x *= -1;', 0aH, 0aH
	DB	'    float3 pos = sphere(uv)*2;', 0aH, '    float3 posX = sphe'
	DB	're(uv+float2(.05,0))*2;', 0aH, '    float3 posY = sphere(uv+f'
	DB	'loat2(0,0.05))*2;', 0aH, '    float3 t = normalize(posX-pos);'
	DB	0aH, '    float3 b = normalize(posY-pos);', 0aH, '    float3 n'
	DB	'= -cross(t,b);', 0aH, 0aH, '    float a1= sin(a.x*4096/4)+sin'
	DB	'(a.y*4096/4)*.26;', 0aH, '    float3 ofs= n*a1;', 0aH, '    ', 0aH
	DB	'    ofs+= (-b)*a1*(.5+.2*sin(dot(b,t)*444));', 0aH, '    ', 0aH
	DB	'    float m =saturate(1-abs(uv.y-.5)*2.1);', 0aH, ' //   m=po'
	DB	'w(m,.25);', 0aH, '  //  pos+=ofs*m*.5;', 0aH, '  //  pos.y-=a'
	DB	'1*.4*saturate(-pos.y);', 0aH, '    ', 0aH, '  //  pos+=a1*flo'
	DB	'at3(sin(pos.x*1214),sin(pos.y*2112),sin(pos.y*1122))*.05*m;', 0aH
	DB	'//    pos = rotY(pos, time.x * 0.01);', 0aH, 0aH, '    //', 0aH
	DB	'    //return 1;', 0aH, '    return float4(pos, 1.);', 0aH, 0aH
	DB	'}', 0aH, 00H				; `string'
CONST	ENDS
;	COMDAT ??_C@_0BHJ@OFOBBDN@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
CONST	SEGMENT
??_C@_0BHJ@OFOBBDN@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#incl'
	DB	'ude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.shad'
	DB	'er>', 0aH, '#include <../lib/utils.shader>', 0aH, 0aH, 'cbuff'
	DB	'er params : register(b0)', 0aH, '{', 0aH, '    float hilight;'
	DB	0aH, '};', 0aH, 0aH, '#define PI 3.141592653589793238462643383'
	DB	'2795', 0aH, 0aH, 'float4 PS(VS_OUTPUT_PARTICLE input, bool is'
	DB	'FrontFace : SV_IsFrontFace) : SV_Target', 0aH, '{', 0aH, '   '
	DB	' float3 c = saturate(1.-2.*length(input.uv-.5));', 0aH, 0aH, ' '
	DB	'   return float4(c*input.color.rgb,1);', 0aH, 0aH, '}', 0aH, 00H ; `string'
CONST	ENDS
;	COMDAT ??_C@_0CJA@JFPOCJFA@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@
CONST	SEGMENT
??_C@_0CJA@JFPOCJFA@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#inc'
	DB	'lude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sha'
	DB	'der>', 0aH, '#include <../lib/utils.shader>', 0aH, 0aH, 'cbuf'
	DB	'fer params : register(b0)', 0aH, '{', 0aH, '    float hilight'
	DB	';', 0aH, '};', 0aH, 0aH, '#define PI 3.1415926535897932384626'
	DB	'433832795', 0aH, 0aH, 'float4 PS(VS_OUTPUT_PARTICLE input, bo'
	DB	'ol isFrontFace : SV_IsFrontFace) : SV_Target', 0aH, '{', 0aH, ' '
	DB	'   float3 c = saturate(1.-2.*length(input.uv-.5));', 0aH, 0aH
	DB	'    float2 uv=2*(input.uv-.5);', 0aH, '    float2 suv =abs(uv'
	DB	');', 0aH, '    float d=2./((length(uv.xy-uv.yx)+length(uv.xy+'
	DB	'uv.yx))/2);', 0aH, '          d+=2./(suv.x+suv.y);', 0aH, '  '
	DB	'  d*=saturate(1-max(suv.x,suv.y));', 0aH, '    //  d+=c*3;', 0aH
	DB	'    if (length(input.size)<=1.1) return float4(15*input.color'
	DB	'.rgb/9.,1);', 0aH, 0aH, '    return float4(d*input.color.rgb/'
	DB	'9.,1);', 0aH, 0aH, '}', 0aH, 00H		; `string'
CONST	ENDS
;	COMDAT ??_C@_0CAF@HDCAHCBB@?$CDinclude?5?$DM?4?4?1?4?4?1lib?1constBuf?4sh@
CONST	SEGMENT
??_C@_0CAF@HDCAHCBB@?$CDinclude?5?$DM?4?4?1?4?4?1lib?1constBuf?4sh@ DB '#'
	DB	'include <../../lib/constBuf.shader>', 0aH, '#include <../../l'
	DB	'ib/io.shader>', 0aH, '#include <../../lib/constants.shader>', 0aH
	DB	0aH, '//[', 0aH, 0aH, 'cbuffer params : register(b0)', 0aH, '{'
	DB	0aH, '    float4x4 model;', 0aH, '    float4 position [4000];', 0aH
	DB	'}', 0aH, '//]', 0aH, 0aH, 0aH, 'VS_OUTPUT VS(uint vID : SV_Ve'
	DB	'rtexID)', 0aH, '{', 0aH, '    VS_OUTPUT output = (VS_OUTPUT) '
	DB	'0;', 0aH, '    ', 0aH, '    float4 pos = float4(position[vID]'
	DB	'.xyz, 1);', 0aH, '    pos.xyz = mul(pos.xyz, (float3x3)model)'
	DB	';', 0aH, '    pos.z += 12;', 0aH, ' ', 0aH, '    output.pos ='
	DB	' mul(pos, proj[0]);', 0aH, '    output.wpos = position[vID];', 0aH
	DB	'    output.uv = position[vID].w;', 0aH, '    return output;', 0aH
	DB	'}', 0aH, 00H				; `string'
CONST	ENDS
;	COMDAT ??_C@_0BMI@BBGHGPEO@?$CDinclude?5?$DM?4?4?1?4?4?1lib?1constBuf?4sh@
