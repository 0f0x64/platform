	DB	'density compensation', 0aH, '    p.color/=min(pow(p.pos.w,1.1'
	DB	')*.1+.5,11);', 0aH, '    return p;', 0aH, '}', 0aH, 0aH, 'pos'
	DB	'_color sagittarius_v2 (uint qid,float div, float4 grid)', 0aH
	DB	'{', 0aH, '    pos_color outp;', 0aH, 0aH, 0aH, '    //percent'
	DB	'age', 0aH, '    uint outer=612;', 0aH, '    uint floor_=23;', 0aH
	DB	'    uint star_=15;', 0aH, '    uint star_2=4957;', 0aH, '    '
	DB	'uint big_hl=2006;', 0aH, 0aH, '    float3 pos=0;', 0aH, '    '
	DB	0aH, '    outp = pillars_array(qid,grid);', 0aH, ' //   if (qi'
