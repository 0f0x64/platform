??_C@_0IMG@GKIECDGH@?$CDinclude?5?$DM?4?4?1lib?1constBuf?4shade@ DB '#inc'
	DB	'lude <../lib/constBuf.shader>', 0aH, '#include <../lib/io.sha'
	DB	'der>', 0aH, '#include <../lib/constants.shader>', 0aH, '#incl'
	DB	'ude <../lib/utils.shader>', 0aH, 0aH, 'cbuffer params : regis'
	DB	'ter(b0)', 0aH, '{', 0aH, '    float4x4 model;', 0aH, '    int'
	DB	' gX;', 0aH, '    int gY;', 0aH, '    int mode;', 0aH, '    in'
	DB	't skipper;', 0aH, '}', 0aH, 0aH, 'float toRad(float a)', 0aH, '{'
	DB	0aH, '    return a*PI/180.;', 0aH, '}', 0aH, 0aH, 'float tri(f'
	DB	'loat x)', 0aH, '{', 0aH, '    return lerp(frac(x),1-frac(x),f'
	DB	'loor(frac(x/2)*2));', 0aH, '}', 0aH, 0aH, 'pos_color CalcPart'
	DB	'icles(uint qid,uint iid,float4 grid)', 0aH, '{', 0aH, 'uint s'
	DB	'tar2=110;', 0aH, 0aH, '     qid *= skipper;', 0aH, '     floa'
	DB	't t=time.x*.004;', 0aH, '     uint inStars = 10000;', 0aH, ' '
	DB	'    if (mode==1||iid%inStars==0)', 0aH, '     {', 0aH, '     '
	DB	'   t=0;', 0aH, '     }', 0aH, 0aH, '    float y1=(grid.y-.5)*'
	DB	'2.;', 0aH, '    float y2=pow((smoothf(grid.y)-.5)*2.,3.);', 0aH
	DB	'    float y=lerp(y1,y2,0.);', 0aH, '    float3 pos = float3(0'
	DB	',y,0);', 0aH, 0aH, '    pos.z=0;', 0aH, '    float scale=sin('
	DB	'abs(grid.y-.5)*PI*2)/9+.1;', 0aH, '    float scale2=scale;', 0aH
	DB	'    scale2=pow(scale,3)*72;', 0aH, 0aH, '    float tm=time.x;'
	DB	0aH, '        float dir=sign(y1)*((iid%2)-.5);', 0aH, '    //', 0aH
	DB	'    /*if (iid%star2==0)', 0aH, '    {', 0aH, '        pos.y=f'
	DB	'rac(pos.y-time.x*.001*dir*sign(y1))*sign(pos.y);', 0aH, '    '
	DB	'    pos-=noise3(iid/11100.)*scale2*1.2;', 0aH, '    }*/', 0aH
	DB	0aH, '    pos = rotZ(pos,pos.y*sign(pos.y)*7.85);', 0aH, 0aH, ' '
	DB	'   //if (iid%9==0&&iid%star2!=0) pos+=normalize(pos)*noise(po'
	DB	's*25);', 0aH, 0aH, '    pos.x+=(iid%2)*2;', 0aH, '    pos=pos'
	DB	'.yzx;', 0aH, '    pos*=4;', 0aH, '    pos.z-=4;', 0aH, '    f'
	DB	'loat3 g1 =noise3(pos*4)*pow(length(pos),1)*.1-.5;', 0aH, '   '
	DB	' float y3=grid.y;', 0aH, '    float3 g=float3(y3/12.,y3/22.,y'
	DB	'3/14.)*5134+g1;', 0aH, '    ', 0aH, '    //if (iid%star2!=0)', 0aH
	DB	'    {', 0aH, '        //pos+=noise3((hash(iid/2112.)-.5)*floa'
	DB	't3(1,2,3)*12)*.2;', 0aH, '        pos+=noise3(g*.2+tm.x*.15*d'
	DB	'ir)*scale2*.51;', 0aH, '        pos+=noise3(grid.xyy*8+dir*tm'
	DB	'.x*.0000*+iid/41111.)*2.3*scale2;', 0aH, '      //pos+=noise3'
	DB	'(pos*11.2)*.151;', 0aH, '    }', 0aH, 0aH, '    pos_color p;', 0aH
	DB	0aH, '    {', 0aH, '    float dir=(iid%2-.5);', 0aH, '    floa'
	DB	't v=15;', 0aH, '    float q= .5+lerp(grid.y,1-grid.y,iid%2)/2'
	DB	';', 0aH, '    q=.5+dir*(lerp(saturate((1-grid.y)*v),saturate('
	DB	'grid.y*v),iid%2));', 0aH, '    p.color=.0125*float4(lerp(floa'
	DB	't3(1,0.2,0.1),float3(0.1,0.2,1),q)*(noise3(pos*1.1)*.5+.6),1)'
	DB	';', 0aH, '    }', 0aH, 0aH, 0aH, '    if (mode==0)', 0aH, '  '
