	DB	's.x=rotZ(pos,pos.y);', 0aH, '    //pos+=noise3(pos+time.x/15)'
	DB	';', 0aH, 0aH, '    //pos+=((iid%16)-8)/9;', 0aH, '  //  pos=r'
	DB	'ot3(pos,iid%16);', 0aH, 0aH, '    //pos=lerp(normalize(pos3)*'
