	DB	'.1+1.5,5);', 0aH, '    ', 0aH, '    return p;', 0aH, '}', 0aH
	DB	0aH, 0aH, 0aH, 0aH, 0aH, 'pos_color pillars_array(uint qid,flo'
	DB	'at4 grid)', 0aH, '{', 0aH, '    uint glow = qid%(10394);', 0aH
