	DB	'    //extra animation', 0aH, '    ', 0aH, '    ', 0aH, 0aH, 0aH
	DB	'    pos_color p;', 0aH, ' p.color = float4(noise3_u(a*float3('
	DB	'13,15,12)*221+77+sin(pos2*1.4)),1)/30.+.0015;', 0aH, '    if '
