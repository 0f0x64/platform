	DB	'        ', 0aH, '        pos/=2;', 0aH, 0aH, '        pos+=5/'
	DB	'rot3(pos,noise3(sin(pos/4+time.x/540)));', 0aH, '        pos='
	DB	'rot3(pos,noise3(sin(pos/9+time.x/540)));', 0aH, '        pos+'
	DB	'=1/rot3(pos,noise3(sin(pos/3+time.x/540)));', 0aH, 0aH, '    '
