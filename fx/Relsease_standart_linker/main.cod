	DB	't skipper;', 0aH, '    float4 base_color;', 0aH, ' ', 0aH, '}'
	DB	0aH, 0aH, 'float3 pillar(float2 grid,float a, float t, float h'
	DB	')', 0aH, '{', 0aH, '    float3 pos = shp(grid.xy);', 0aH, '  '
	DB	'  //heigth', 0aH, '    pos.y*=.8+h;', 0aH, '    pos.y+=h;', 0aH
