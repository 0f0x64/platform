turn floor(f*h)/h;}float4 transform(float3 f,float2 h,float x){h-=.5;float2 r=float2(proj[0]._m00,proj[0]._m11);float4 n=mul(float4(f,1),view[0]),p=mul(n,proj[0]);r=h*x*.1;n.xy+=r;return mul(n,proj[0]);}float4 transform_unisize(float3 f,float2 h,float x){h-=.5;float2 r=float2(proj[0]._m00,proj[0]._m11);float4 n=mul(float4(f,1),view[0]),p=mul(n,proj[0]);r=h*.002*(n.z/n.w)*x*(normalize(r)*2);n=mul(n,proj[0]);n.xy+=r;return n;}